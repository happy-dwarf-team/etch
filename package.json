{
  "name": "etch-workspace",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p . && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit && pnpm test:renderer && pnpm test:extension",
    "test:unit": "vitest run",
    "test:renderer": "pnpm --filter @etch/renderer --filter @etch/compare test",
    "test:extension": "pnpm --filter etch test",
    "pins": "pnpm --filter etch pins",
    "package": "pnpm --filter etch package",
    "media": "node packages/media/src/cli.mts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
