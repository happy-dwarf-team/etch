# Only the bundle, the manifest, the icon, the walkthrough's pictures, the
# documents and the staged game-side builds go into the VSIX;
# package.mts checks the list.
**
!dist/extension.js
!dist/webview.js
!dist/texture-webview.js
!dist/mesh-webview.js
!dist/build.json
!dist/profiles/**
!media/icon.png
!media/walkthrough/*.svg
!package.json
!README.md
!CHANGELOG.md
!LICENSE
!THIRD-PARTY-NOTICES.md
!game/**
