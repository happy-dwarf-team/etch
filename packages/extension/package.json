{
  "name": "etch",
  "displayName": "Etch",
  "description": "Preview Europa Universalis IV interface mods while you edit them.",
  "version": "1.0.1",
  "publisher": "happy-dwarf-team",
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#16171a",
    "theme": "dark"
  },
  "homepage": "https://github.com/happy-dwarf-team/etch#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/happy-dwarf-team/etch.git",
    "directory": "packages/extension"
  },
  "bugs": {
    "url": "https://github.com/happy-dwarf-team/etch/issues"
  },
  "qna": "https://github.com/happy-dwarf-team/etch/issues",
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "Europa Universalis IV",
    "EU4",
    "Paradox",
    "Clausewitz",
    "modding",
    "gui",
    "gfx",
    "interface"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:etch.preview",
    "workspaceContains:**/*.gui",
    "workspaceContains:**/*.gfx",
    "workspaceContains:**/localisation/**/*.yml"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "etch.widgetOutline",
          "name": "Widget Outline",
          "when": "etch.widgetOutline.available"
        }
      ]
    },
    "commands": [
      {
        "command": "etch.openPreview",
        "title": "Open Preview",
        "category": "Etch",
        "icon": "$(open-preview)"
      },
      {
        "command": "etch.togglePreviewPin",
        "title": "Pin or Unpin the Previewed Window",
        "category": "Etch",
        "icon": "$(pin)"
      },
      {
        "command": "etch.choosePreviewResolution",
        "title": "Choose the Preview Resolution",
        "category": "Etch",
        "icon": "$(screen-full)"
      },
      {
        "command": "etch.outline.hide",
        "title": "Hide by Hand",
        "category": "Etch",
        "icon": "$(eye)"
      },
      {
        "command": "etch.outline.show",
        "title": "Show by Hand",
        "category": "Etch",
        "icon": "$(eye-closed)"
      },
      {
        "command": "etch.outline.choose",
        "title": "Choose by Hand",
        "category": "Etch",
        "icon": "$(circle-large-outline)"
      },
      {
        "command": "etch.startLiveGame",
        "title": "Start the Live Game",
        "category": "Etch"
      },
      {
        "command": "etch.stopLiveGame",
        "title": "Stop the Live Game",
        "category": "Etch"
      },
      {
        "command": "etch.removePrivateInstall",
        "title": "Remove the Private Install",
        "category": "Etch"
      },
      {
        "command": "etch.openLiveGameSaves",
        "title": "Open the Live Game's Saves Folder",
        "category": "Etch"
      },
      {
        "command": "etch.togglePickMode",
        "title": "Toggle Pick Mode",
        "category": "Etch"
      },
      {
        "command": "etch.overrideInMyMod",
        "title": "Override in My Mod",
        "category": "Etch"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "etch.openPreview",
          "when": "resourceExtname =~ /^\\.gui$/i",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "etch.outline.hide",
          "when": "view == etch.widgetOutline && viewItem == etch.shown",
          "group": "inline"
        },
        {
          "command": "etch.outline.show",
          "when": "view == etch.widgetOutline && viewItem == etch.hidden",
          "group": "inline"
        },
        {
          "command": "etch.outline.choose",
          "when": "view == etch.widgetOutline && viewItem == etch.member",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "etch.togglePreviewPin",
          "when": "etch.previewOpen"
        },
        {
          "command": "etch.outline.hide",
          "when": "false"
        },
        {
          "command": "etch.outline.show",
          "when": "false"
        },
        {
          "command": "etch.outline.choose",
          "when": "false"
        },
        {
          "command": "etch.overrideInMyMod",
          "when": "resourceScheme == file && resourcePath =~ /[\\\\/]interface[\\\\/][^\\\\/]+\\.(gui|gfx)$/i"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "**/.etch/profiles/*.jsonc",
        "url": "./dist/profiles/window-profile.schema.json"
      }
    ],
    "configuration": {
      "title": "Etch",
      "properties": {
        "etch.gamePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The Europa Universalis IV game folder, the one that holds `eu4.exe`. When empty, Etch finds it through Steam's library list. Etch only reads this folder."
        },
        "etch.playset": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Mods to preview with, in load order (a later mod's file wins), as mod names or as mod folders or `.mod` descriptors. When not empty it replaces the default playset: the edited mod and the `dependencies` of its descriptor. The edited mod is added last unless the list names it."
        },
        "etch.language": {
          "type": "string",
          "default": "english",
          "enum": [
            "english",
            "french",
            "german",
            "spanish"
          ],
          "scope": "resource",
          "markdownDescription": "The localisation language the preview shows a `.gui` file's texts in."
        },
        "etch.previewResolution": {
          "type": "string",
          "default": "default",
          "pattern": "^\\s*(?:[Dd][Ee][Ff][Aa][Uu][Ll][Tt]|[Nn][Aa][Tt][Ii][Vv][Ee]|\\d+\\s*[xX×*]\\s*\\d+)?\\s*$",
          "patternErrorMessage": "Write default, native or a width × height such as 1920x1080.",
          "examples": [
            "default",
            "native",
            "1280x720",
            "1366x768",
            "1600x900",
            "1680x1050",
            "1920x1080",
            "3440x1440"
          ],
          "scope": "window",
          "markdownDescription": "The screen size the preview lays windows out on and evaluates `if_resolution` blocks against: `default` (the resolution in the game's `settings.txt`, else the monitor's), `native` (the monitor's resolution), or a width × height such as `1920x1080`. UI scale is always 1.0. The command **Etch: Choose the Preview Resolution** also offers the corpus resolutions."
        },
        "etch.liveGame.pickModeKey": {
          "type": "string",
          "default": "Ctrl+Shift+E",
          "pattern": "^\\s*(?:(?:[Cc][Tt][Rr][Ll]|[Ss][Hh][Ii][Ff][Tt]|[Aa][Ll][Tt])\\s*\\+\\s*)+(?:[A-Za-z0-9]|[Ff](?:[1-9]|1[0-9]|2[0-4]))\\s*$",
          "patternErrorMessage": "Write Ctrl or Alt (with Shift if you like) and a letter, a digit or F1-F24, such as Ctrl+Shift+E.",
          "scope": "machine",
          "markdownDescription": "The key that turns pick mode on and off in the live game: Ctrl or Alt, with Shift if you like, and a letter, a digit or F1-F24. The game binds nothing to the default `Ctrl+Shift+E`; Esc is never taken. A change applies to a running live game at once."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mts",
    "typecheck": "tsc -p . && tsc -p webview",
    "test": "node build.mts && node test/run.mts",
    "pins": "node stage-game.mts",
    "package": "node build.mts && node stage-game.mts && node package.mts"
  },
  "devDependencies": {
    "@etch/core": "workspace:*",
    "@etch/renderer": "workspace:*",
    "@types/vscode": "~1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0"
  }
}
