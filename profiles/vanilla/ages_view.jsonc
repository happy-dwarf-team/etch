// The ages_view window of the base game (docs/window-profiles.md). Its rule hides what the coverage
// survey's 2 captures of it show hidden; drafted from them, as the corpus's are (ADR 0006).
{
  "formatVersion": 1,
  "window": "ages_view",
  "checkedWith": "1.37.5",
  "selectors": {
    "age": {
      "kind": "ui",
      "label": "Age",
      "values": {
        "discovery": "Age of Discovery",
        "reformation": "Age of Reformation",
        "absolutism": "Age of Absolutism",
        "revolutions": "Age of Revolutions",
      },
      "note": "The game shows the panel of the current age: discovery in 1444, reformation in 1550, revolutions in 1719 (the coverage survey, etch#258).",
    },
  },
  "groups": {
    "age": {
      "label": "Age",
      "selector": "age",
      "members": {
        "discovery": "ages_view/age_of_discovery",
        "reformation": "ages_view/age_of_reformation",
        "absolutism": "ages_view/age_of_absolutism",
        "revolutions": "ages_view/age_of_revolutions",
      },
    },
  },
  "rules": {
    "picture-discovery": {
      "note": "The game's code gives picture the current age's sprite (504 × 162) in place of the .gui's (the coverage survey, vanilla and Anbennar, both resolutions); Anbennar keeps the base game's age keys.",
      "when": { "age": "discovery" },
      "sprite": { "ages_view/picture": "GFX_age_of_discovery" },
    },
    "picture-reformation": {
      "when": { "age": "reformation" },
      "sprite": { "ages_view/picture": "GFX_age_of_reformation" },
    },
    "picture-absolutism": {
      "when": { "age": "absolutism" },
      "sprite": { "ages_view/picture": "GFX_age_of_absolutism" },
    },
    "picture-revolutions": {
      "when": { "age": "revolutions" },
      "sprite": { "ages_view/picture": "GFX_age_of_revolutions" },
    },
    "hidden": {
      "note": "Hidden in every view of the coverage survey (the base game): the game decides these from its data or a click; show one by hand.",
      "hide": ["ages_view/golden_age", "ages_view/in_golden_age_banner"],
    },
  },
}
