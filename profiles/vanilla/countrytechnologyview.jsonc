// The countrytechnologyview window of the base game (docs/window-profiles.md). Its rule hides what the coverage
// survey's 4 captures of it show hidden; drafted from them, as the corpus's are (ADR 0006).
{
  "formatVersion": 1,
  "window": "countrytechnologyview",
  "checkedWith": "1.37.5",
  "selectors": {
    "institutions": {
      "kind": "ui",
      "label": "Institutions",
      "values": { "closed": "Closed", "open": "Open" },
      "default": "closed",
      "note": "show_institutions opens institutions_window over the tab (the coverage survey, vanilla and Anbennar: closed as the tab opens, open after the click).",
    },
    "institution": {
      "kind": "data",
      "label": "Institution",
      "fact": "country.institution",
      "values": {
        "feudalism": "Feudalism",
        "renaissance": "Renaissance",
        "new_world_i": "Colonialism",
        "printing_press": "Printing Press",
        "global_trade": "Global Trade",
        "manufactories": "Manufactories",
        "enlightenment": "Enlightenment",
        "industrialization": "Industrialization",
        "none": "All embraced",
      },
      "default": "industrialization",
      "note": "The institution the window shows, whose bonus the game's code writes in when_embraced, a modifier a line (eu4.exe 0x1017C50). It opens on the first institution the country has not embraced (0x1018150), which a save tells; a click on another icon shows that one. All embraced, the game leaves the text as it was, empty in a new game.",
    },
  },
  "rules": {
    "institutions-closed": {
      "when": { "institutions": "closed" },
      "hide": ["countrytechnologyview/institutions_window"],
    },
    "when-embraced-feudalism": {
      "when": { "institutions": "open", "institution": "feudalism" },
      "note": "Feudalism's bonus, as the game writes it when the window shows it (the base game, Russia on 17 March 1719, each icon clicked).",
      "text": {
        "countrytechnologyview/institutions_window/when_embraced": {
          "key": "MODIFIER_FREE_LEADER_POOL",
          "suffix": ": +1",
        },
      },
    },
    "when-embraced-renaissance": {
      "when": { "institutions": "open", "institution": "renaissance" },
      "note": "Renaissance's bonus, as the game writes it when the window shows it (the base game, Russia on 17 March 1719, each icon clicked).",
      "text": {
        "countrytechnologyview/institutions_window/when_embraced": [
          { "key": "BUILD_COST", "suffix": ": -5.0%\n" },
          { "key": "DEVELOPMENT_COST", "suffix": ": -5.0%" },
        ],
      },
    },
    "when-embraced-new-world-i": {
      "when": { "institutions": "open", "institution": "new_world_i" },
      "note": "Colonialism's bonus, as the game writes it when the window shows it (the base game, Russia on 17 March 1719, each icon clicked).",
      "text": {
        "countrytechnologyview/institutions_window/when_embraced": {
          "key": "GLOBAL_PROV_TRADE_POWER_MODIFIER",
          "suffix": ": +10.0%",
        },
      },
    },
    "when-embraced-printing-press": {
      "when": { "institutions": "open", "institution": "printing_press" },
      "note": "Printing Press's bonus, as the game writes it when the window shows it (the base game, Russia on 17 March 1719, each icon clicked).",
      "text": {
        "countrytechnologyview/institutions_window/when_embraced": {
          "key": "STABILITY_COST_MODIFIER",
          "suffix": ": -5.0%",
        },
      },
    },
    "when-embraced-global-trade": {
      "when": { "institutions": "open", "institution": "global_trade" },
      "note": "Global Trade's bonus, as the game writes it when the window shows it (the base game, Russia on 17 March 1719, each icon clicked).",
      "text": {
        "countrytechnologyview/institutions_window/when_embraced": {
          "key": "YEARLY_MERCHANTS",
          "suffix": ": +1",
        },
      },
    },
    "when-embraced-manufactories": {
      "when": { "institutions": "open", "institution": "manufactories" },
      "note": "Manufactories's bonus, as the game writes it when the window shows it (the base game, Russia on 17 March 1719, each icon clicked).",
      "text": {
        "countrytechnologyview/institutions_window/when_embraced": {
          "key": "MODIFIER_GLOBAL_TRADE_GOODS_SIZE_MODIFIER",
          "suffix": ": +10.0%",
        },
      },
    },
    "when-embraced-enlightenment": {
      "when": { "institutions": "open", "institution": "enlightenment" },
      "note": "Enlightenment's bonus, as the game writes it when the window shows it (the base game, Russia on 17 March 1719, each icon clicked).",
      "text": {
        "countrytechnologyview/institutions_window/when_embraced": {
          "key": "MODIFIER_CULTURE_CONVERSION_COST",
          "suffix": ": -25.0%",
        },
      },
    },
    "when-embraced-industrialization": {
      "when": { "institutions": "open", "institution": "industrialization" },
      "note": "Industrialization's bonus, as the game writes it when the window shows it (the base game, Russia on 17 March 1719, each icon clicked).",
      "text": {
        "countrytechnologyview/institutions_window/when_embraced": [
          { "key": "GLOBAL_TAX_MODIFIER", "suffix": ": +15.0%\n" },
          { "key": "GLOBAL_MANPOWER", "suffix": ": +25.0%" },
        ],
      },
    },
    "institutions-window": {
      "note": "The game places the institutions window as if the tab were at y 0, not at its show_position's 140 (the coverage survey, every playset, 1920×1080 and 1280×720; etch#253). Nothing in the tab's code that sets a position explains it.",
      "offset": { "countrytechnologyview/institutions_window": { "y": -140 } },
    },
    "hidden": {
      "note": "Hidden in every view of the coverage survey (the base game): the game decides these from its data or a click; show one by hand.",
      "hide": [
        "countrytechnologyview/institutions_window/embrace_cost",
        "countrytechnologyview/institutions_window/goto_origin",
        "countrytechnologyview/institutions_window/spread_info_icon",
      ],
    },
  },
}
