// The province view of the base game (spec v2 section 11, docs/window-profiles.md), from the
// province view research (etch#155) and the corpus captures. Etch derives the _large pairs and the
// positionType moves of the screen height itself (spec section 3), so they are not written here.
{
  "formatVersion": 1,
  "window": "provinceview",
  "checkedWith": "1.37.5",
  "selectors": {
    "screen": {
      "kind": "resolution",
      "label": "Screen height",
      "values": {
        "small": { "label": "813 px or less", "maxHeight": 813 },
        "large": { "label": "814 px or more", "minHeight": 814 },
      },
    },
    "owner": {
      "kind": "data",
      "label": "Province owner",
      "fact": "province.ownedByPlayer",
      "values": { "yes": "Own", "no": "Foreign" },
    },
    "tab": {
      "kind": "ui",
      "label": "Tab",
      "values": { "province": "Province", "state": "State" },
      "note": "The game remembers the tab between provinces.",
    },
    "side": {
      "kind": "ui",
      "label": "Side panel",
      "values": {
        "buildings": "Buildings",
        "institutions": "Institutions",
        "history": "History",
        "none": "None",
      },
    },
    "subPanel": {
      "kind": "ui",
      "label": "Sub-panel",
      "values": {
        "none": "None",
        "change_culture_view": "Change culture",
        "build_army_view": "Build army",
        "build_navy_view": "Build navy",
        "client_state_selection": "Client state",
        "transfer_occupation_window": "Transfer occupation",
        "tradegoods_province_window": "Trade goods",
        "allied_objectives_list": "Allied objectives",
      },
      "note": "Each opens on its button: change_culture_button, build_landunit_button, build_navy_button, client_state_button, transfer_occupation_button, resource_icon, select_allied_objective.",
    },
    "construction": {
      "kind": "data",
      "label": "Construction",
      "fact": "province.constructing",
      "values": { "yes": "Building", "no": "Nothing" },
      "default": "no",
    },
    "occupied": {
      "kind": "data",
      "label": "Occupation",
      "fact": "province.occupied",
      "values": { "yes": "Occupied", "no": "Not occupied" },
      "default": "no",
    },
    "greatProjects": {
      "kind": "data",
      "label": "Great projects",
      "fact": "province.hasGreatProjects",
      "values": { "yes": "Some", "no": "None" },
      "default": "no",
    },
    "natives": {
      "kind": "data",
      "label": "Buildings",
      "fact": "owner.buildsNativeBuildings",
      "values": { "yes": "Native", "no": "Normal" },
      "default": "no",
    },
    "hre": {
      "kind": "data",
      "label": "Empire indicator",
      "fact": "province.hreIndicator",
      "values": { "yes": "Shown", "no": "None" },
      "default": "no",
      "note": "The game shows it where the empire exists and the province can be part of it: the button in an own province, the icon in a foreign one.",
    },
    "fort": {
      "kind": "data",
      "label": "Fort",
      "fact": "province.hasFort",
      "values": { "yes": "Fort", "no": "No fort" },
      "default": "yes",
    },
    "capital": {
      "kind": "data",
      "label": "Capital",
      "fact": "province.isCapital",
      "values": { "yes": "Capital", "no": "Not capital" },
      "default": "no",
      "note": "The capital shows have_capital in the first slot of the top section, an own province move_capital (eu4.exe 0x1349580).",
    },
    "tradePort": {
      "kind": "data",
      "label": "Trade port",
      "fact": "province.isTradePort",
      "values": { "yes": "Trade port", "no": "Not trade port" },
      "default": "no",
      "note": "An own trade port shows have_trade_port in the second slot, another own province move_trade_port (0x134A530).",
    },
    "parliament": {
      "kind": "data",
      "label": "Parliament",
      "fact": "province.parliamentSeat",
      "values": { "seat": "Seat", "noSeat": "No seat", "none": "No parliament" },
      "default": "none",
      "note": "The third slot of an own province: add_parliament without a seat, remove_parliament with one; have_parliament replaces remove_parliament where seats cannot be removed (0x13497F0), shown by hand.",
    },
    "centerOfTrade": {
      "kind": "data",
      "label": "Centre of trade",
      "fact": "province.centerOfTrade",
      "values": { "yes": "Centre of trade", "no": "None" },
      "default": "no",
    },
    "colonised": {
      "kind": "data",
      "label": "Colonised",
      "fact": "province.owned",
      "values": { "yes": "Owned", "no": "Uncolonised" },
      "default": "yes",
      "note": "An uncolonised province opens colonisationpanel instead (etch#155).",
    },
  },
  // Sample data (spec section 5): the save's values where a province block holds them (etch#154),
  // engine values (income, unrest, supply, modifiers) only from a live snapshot, generated text
  // under everything. Area and region names need the map files, which Etch does not read.
  "content": {
    "provinceview/top_section_window/provincename": { "save": "provinces.{province}.name" },
    "provinceview/top_section_window/capitalname": { "save": "provinces.{province}.capital" },
    "provinceview/top_section_window/area_name": { "generated": "text" },
    "provinceview/top_section_window/region_name": { "generated": "text" },
    "provinceview/province_window/tax_base_value": {
      "save": "provinces.{province}.base_tax",
      "format": "number",
    },
    "provinceview/province_window/prod_base_value": {
      "save": "provinces.{province}.base_production",
      "format": "number",
    },
    "provinceview/province_window/mp_base_value": {
      "save": "provinces.{province}.base_manpower",
      "format": "number",
    },
    "provinceview/province_window/development_value": {
      "save": [
        "provinces.{province}.base_tax",
        "provinces.{province}.base_production",
        "provinces.{province}.base_manpower",
      ],
      "transform": "sum",
    },
    "provinceview/province_window/tax_value": { "engine": true, "generated": "number" },
    "provinceview/province_window/production_value": { "engine": true, "generated": "number" },
    "provinceview/province_window/total_value": { "engine": true, "generated": "number" },
    "provinceview/province_window/religion": {
      "save": "provinces.{province}.religion",
      "transform": "localise",
    },
    "provinceview/province_window/culture": {
      "save": "provinces.{province}.culture",
      "transform": "localise",
    },
    "provinceview/province_window/unrest_value": { "engine": true, "generated": "number" },
    "provinceview/province_window/local_autonomy_value": {
      "save": "provinces.{province}.local_autonomy",
      "format": "percent",
    },
    "provinceview/province_window/queue_window/land_amount": {
      "engine": true,
      "generated": "number",
    },
    "provinceview/province_window/queue_window/naval_amount": {
      "engine": true,
      "generated": "number",
    },
    "provinceview/province_window/occupied_by": {
      "save": "provinces.{province}.controller",
      "transform": "localise",
    },
    "provinceview/province_window/sailor_value": { "engine": true, "generated": "number" },
    "provinceview/province_window/manpower_value": { "engine": true, "generated": "number" },
    "provinceview/province_window/supply_value": { "engine": true, "generated": "number" },
    "provinceview/province_window/attrition_value": { "engine": true, "generated": "number" },
    "provinceview/province_window/warscore_value": { "engine": true, "generated": "percent" },
    "provinceview/province_window/defensiveness_value": { "engine": true, "generated": "percent" },
    "provinceview/province_window/garrison_value": {
      "save": "provinces.{province}.garrison",
      "format": "number",
      "decimals": 0,
    },
    "provinceview/province_window/fort_number": { "engine": true, "generated": "number" },
    "provinceview/province_window/tradepower_value": {
      "save": "provinces.{province}.trade_power",
      "format": "number",
      "decimals": 1,
    },
    "provinceview/province_window/tradevalue_value": { "engine": true, "generated": "number" },
    "provinceview/province_window/goodsproduced_value": { "engine": true, "generated": "number" },
    "provinceview/province_window/resource_price_value": { "engine": true, "generated": "number" },
    "provinceview/province_window/devastation_value": {
      "save": "provinces.{province}.devastation",
      "format": "percent",
    },
    "provinceview/province_window/foreign_province_window/country_name": {
      "save": "provinces.{province}.owner",
      "transform": "localise",
    },
    "provinceview/province_window/foreign_province_window/opinion_box": {
      "engine": true,
      "generated": "number",
    },
    "provinceview/province_window/foreign_province_window/miltech_value": {
      "engine": true,
      "generated": "number",
    },
    "provinceview/province_window/tradegoods_province_window/tradegoods_name": {
      "save": "provinces.{province}.trade_goods",
      "transform": "localise",
    },
    "provinceview/province_window/tradegoods_province_window/tradegoods_base_price_value": {
      "engine": true,
      "generated": "number",
    },
    "provinceview/province_window/tradegoods_province_window/tradegoods_current_price_value": {
      "engine": true,
      "generated": "number",
    },
    "provinceview/province_window/tradegoods_province_window/tradegoods_production_value": {
      "engine": true,
      "generated": "number",
    },
    "provinceview/state_window/state_name": { "generated": "text" },
    "provinceview/state_window/income_value": { "engine": true, "generated": "number" },
    "provinceview/state_window/governing_capacity_value": { "engine": true, "generated": "number" },
    "provinceview/state_window/current_edict": { "generated": "text" },
    "provinceview/buildings_window/**/naval_forcelimit_value": {
      "engine": true,
      "generated": "number",
    },
    "provinceview/buildings_window/**/land_forcelimit_value": {
      "engine": true,
      "generated": "number",
    },
    "provinceview/buildings_window/**/capacity_value": { "engine": true, "generated": "number" },
    "provinceview/buildings_window/**/build_allowed_value": {
      "engine": true,
      "generated": "number",
    },
    "provinceview/buildings_window/**/build_cost_modifier": {
      "engine": true,
      "generated": "percent",
    },
    "provinceview/buildings_window/**/build_time_modifier": {
      "engine": true,
      "generated": "percent",
    },
  },
  // Lists the game's code fills (spec section 5): each with sample entries whose number Data ▾
  // changes. Entries the code puts in a window go where the window's file says: the game reads
  // the positionTypes named in "place" (building_start and its kin), so each playset has its own.
  "repeaters": {
    "provinceview/buildings_window/general_buildings_window": {
      "note": "The building slots, filled and free (building_progress_entry, eu4.exe 0x13899F0): from building_start, building_offset apart, building_max_per_row to a row (the corpus captures).",
      "template": "building_progress_entry",
      "count": 8,
      "place": {
        "start": "building_start",
        "step": "building_offset",
        "columns": "building_max_per_row",
      },
    },
    "provinceview/province_window/build_army_view": {
      "note": "The land units the province can recruit (unit, eu4.exe 0xE217B0): from build_unit, build_unit_offset apart.",
      "template": "unit",
      "count": 4,
      "place": { "start": "build_unit", "step": "build_unit_offset" },
      "fields": {
        "unit/unit_name": { "generated": "text" },
        "unit/unit_cost": { "engine": true, "generated": "number" },
        "unit/unit_buildtime": { "engine": true, "generated": "date" },
      },
    },
    "provinceview/province_window/build_navy_view": {
      "note": "The ships the province can build (naval_unit, eu4.exe 0xE1D5D0): from build_unit, build_unit_offset apart.",
      "template": "naval_unit",
      "count": 3,
      "place": { "start": "build_unit", "step": "build_unit_offset" },
      "fields": {
        "naval_unit/unit_name": { "generated": "text" },
        "naval_unit/unit_cost": { "engine": true, "generated": "number" },
        "naval_unit/unit_buildtime": { "engine": true, "generated": "date" },
      },
    },
    "provinceview/province_window/build_army_view/buildqueue": {
      "note": "The units in construction (queue_entry).",
      "template": "queue_entry",
      "count": 2,
      "fields": {
        "queue_entry/unit_name": { "generated": "text" },
        "queue_entry/subunit_date": { "engine": true, "generated": "date" },
      },
    },
    "provinceview/province_window/build_navy_view/buildqueue": {
      "note": "The ships in construction (queue_entry).",
      "template": "queue_entry",
      "count": 2,
      "fields": {
        "queue_entry/unit_name": { "generated": "text" },
        "queue_entry/subunit_date": { "engine": true, "generated": "date" },
      },
    },
    "provinceview/province_window/change_culture_view/cultures": {
      "note": "The cultures the province can change to (culture_item, eu4.exe 0xE2ABF0).",
      "template": "culture_item",
      "count": 4,
    },
    "provinceview/province_window/cores_box": {
      "note": "One shield per core (CoreShieldItem, eu4.exe 0x136F3C0); claims and territorial cores use their own templates.",
      "template": "CoreShieldItem",
      "from": "provinces.{province}.cores",
      "count": 2,
    },
    "provinceview/province_window/foreign_province_window/diplostatus_box": {
      "note": "The owner's relations with the player (foreignviewview_diplistitem, eu4.exe 0x10CC2F0).",
      "template": "foreignviewview_diplistitem",
      "count": 2,
    },
    "provinceview/province_window/transfer_occupation_window/eligitable_allies": {
      "note": "The allies the occupation can go to (allies_selection_entry).",
      "template": "allies_selection_entry",
      "count": 3,
      "fields": { "allies_selection_entry/name": { "generated": "text" } },
    },
    "provinceview/province_window/allied_objectives_list/list": {
      "note": "The allies an objective can be set for (allied_objective_country).",
      "template": "allied_objective_country",
      "count": 3,
    },
    "provinceview/state_window/provinces_listbox": {
      "note": "The provinces of the state (state_province_entry).",
      "template": "state_province_entry",
      "count": 4,
      "fields": {
        "state_province_entry/name": { "generated": "text" },
        "state_province_entry/development": { "generated": "number" },
        "state_province_entry/culture": { "generated": "text" },
      },
    },
    "provinceview/buildings_window/select_building*/list1": {
      "note": "The buildings a slot can take, which opens on a click on the slot (possible_building_entry).",
      "template": "possible_building_entry",
      "count": 4,
    },
    "provinceview/buildings_window/natives_buildings_window*/buildings": {
      "note": "The native buildings (native_building_entry).",
      "template": "native_building_entry",
      "count": 3,
    },
    "provinceview/institutions_window/institutions": {
      "note": "The institutions and their presence in the province (province_institution_entry, eu4.exe 0x1382CA0).",
      "template": "province_institution_entry",
      "from": "provinces.{province}.institutions",
      "count": 5,
      "fields": {
        "province_institution_entry/progress_label": { "generated": "percent" },
        "province_institution_entry/growth_per_month": { "engine": true, "generated": "number" },
      },
    },
    "provinceview/buildings_window/great_projects_window/great_projects_list": {
      "note": "Entries of great_project_entry (0x1398C30, etch#155), one per great project of the province.",
      "template": "great_project_entry",
      "from": "provinces.{province}.great_projects",
      "count": 1,
      "fields": {
        "great_project_entry/name_label": { "save": "entry", "transform": "localise" },
      },
    },
  },
  "links": {
    "uncolonised": {
      "when": { "colonised": "no" },
      "window": "colonisationpanel",
      "label": "The game opens the colonisation panel for an uncolonised province, not the province view.",
    },
  },
  "groups": {
    "tab": {
      "label": "Tab",
      "selector": "tab",
      "members": {
        "province": "provinceview/province_window",
        "state": "provinceview/state_window",
      },
    },
    "side": {
      "label": "Side panel",
      "selector": "side",
      "none": true,
      "members": {
        "buildings": "provinceview/buildings_window",
        "institutions": "provinceview/institutions_window",
        "history": "provinceview/history_window",
      },
    },
    "subPanel": {
      "label": "Sub-panel",
      "selector": "subPanel",
      "none": true,
      "members": {
        "change_culture_view": "provinceview/province_window/change_culture_view",
        "build_army_view": "provinceview/province_window/build_army_view",
        "build_navy_view": "provinceview/province_window/build_navy_view",
        "client_state_selection": "provinceview/province_window/client_state_selection",
        "transfer_occupation_window": "provinceview/province_window/transfer_occupation_window",
        "tradegoods_province_window": "provinceview/province_window/tradegoods_province_window",
        "allied_objectives_list": "provinceview/province_window/allied_objectives_list",
      },
    },
  },
  "rules": {
    "state-tab": {
      "note": "The state tab closes the side panels.",
      "when": { "tab": "state" },
      "hide": [
        "provinceview/buildings_window",
        "provinceview/institutions_window",
        "provinceview/history_window",
      ],
    },
    "own-province": {
      "when": { "owner": "yes" },
      "hide": [
        "provinceview/provinceview_foreign_bg",
        "provinceview/provinceview_foreign_bg_large",
        "provinceview/top_section_window/province_banner_foreign",
        "provinceview/province_window/foreign_province_window",
      ],
    },
    "foreign-province": {
      "when": { "owner": "no" },
      "hide": [
        "provinceview/provinceview_bg",
        "provinceview/provinceview_bg_large",
        "provinceview/top_section_window/province_banner",
        "provinceview/province_window/queue_window",
      ],
    },
    "build-views": {
      "note": "A build view shows the queue and not the foreign province's panel.",
      "when": { "subPanel": ["build_army_view", "build_navy_view"] },
      "show": ["provinceview/province_window/queue_window"],
      "hide": ["provinceview/province_window/foreign_province_window"],
    },
    "base-values": {
      "note": "The game's code sets the y of the base tax, production and manpower values to development_value_vertical_position_exploitable (62 px in vanilla, 75 px in Proper 2K UI Enhanced) and keeps their x; the .gui writes y = 0 (every corpus capture, own and foreign). development_value_vertical_position_not_exploitable presumably applies where the exploit buttons are hidden.",
      "position": {
        "provinceview/province_window/tax_base_value": {
          "positionType": "development_value_vertical_position_exploitable",
          "axis": "y",
        },
        "provinceview/province_window/prod_base_value": {
          "positionType": "development_value_vertical_position_exploitable",
          "axis": "y",
        },
        "provinceview/province_window/mp_base_value": {
          "positionType": "development_value_vertical_position_exploitable",
          "axis": "y",
        },
      },
    },
    "small-screen": {
      "when": { "screen": "small" },
      "hide": ["provinceview/province_terrain"],
    },
    "no-great-projects": {
      "when": { "greatProjects": "no" },
      "hide": ["provinceview/buildings_window/great_projects_window"],
    },
    "normal-buildings": {
      "when": { "natives": "no" },
      "hide": [
        "provinceview/buildings_window/natives_buildings_window",
        "provinceview/buildings_window/natives_buildings_window_large",
      ],
    },
    "native-buildings": {
      "when": { "natives": "yes" },
      "hide": [
        "provinceview/buildings_window/general_buildings_window",
        "provinceview/buildings_window/province_values_window",
      ],
    },
    "building-picker": {
      "note": "Opens on a click on a building slot.",
      "hide": [
        "provinceview/buildings_window/select_building",
        "provinceview/buildings_window/select_building_large",
      ],
    },
    "no-construction": {
      "note": "Its parts: the Anbennar playset leaves the empty window itself shown.",
      "when": { "construction": "no" },
      "hide": ["provinceview/province_window/progress_bar_window/*"],
    },
    "not-occupied": {
      "when": { "occupied": "no" },
      "hide": [
        "provinceview/province_window/occupied_by",
        "provinceview/province_window/occupied_by_shield",
        "provinceview/province_window/transfer_occupation_button",
      ],
    },
    "hidden-province_window": {
      "note": "Hidden in the corpus captures of an own province (Macedonia, Russia 1719): the game decides these from data every frame; show one by hand.",
      "hide": [
        "provinceview/province_window/abandon_core_button",
        "provinceview/province_window/bad_religion_icon",
        "provinceview/province_window/claim_province_button",
        "provinceview/province_window/hre_button",
        "provinceview/province_window/hre_icon",
        "provinceview/province_window/latent_resource_icon",
        "provinceview/province_window/mp_base_icon",
        "provinceview/province_window/no_building_fort",
        "provinceview/province_window/prod_base_icon",
        "provinceview/province_window/province_religious_conversion_progress",
        "provinceview/province_window/raze_button",
        "provinceview/province_window/settle_tribe_button",
        "provinceview/province_window/tax_base_icon",
        "provinceview/province_window/trade_company_button",
        "provinceview/province_window/trade_company_icon",
        "provinceview/province_window/tradepost_allready_present",
        "provinceview/province_window/trading_city_button",
      ],
    },
    "no-fort": {
      "note": "Without a fort the game shows no_building_fort instead of building_fort and hides the fort's level and maintenance (eu4.exe 0x13728C0; Siroz and Heroes' Rest in the corpus).",
      "when": { "fort": "no" },
      "show": ["provinceview/province_window/no_building_fort"],
      "hide": [
        "provinceview/province_window/building_fort",
        "provinceview/province_window/fort_number",
        "provinceview/province_window/province_view_fort_nr_bg",
        "provinceview/province_window/maintenance_icon",
        "provinceview/province_window/maintenance_lock_icon",
        "provinceview/province_window/fort_maintenance_checkbox",
        "provinceview/province_window/fort_maintenance_lock_checkbox",
      ],
    },
    "build-views-cover-loot": {
      "note": "The game hides loot and devastation while change_culture_view, build_army_view or build_navy_view is open (eu4.exe 0x1373FD0); they would draw over the panel.",
      "when": { "subPanel": ["change_culture_view", "build_army_view", "build_navy_view"] },
      "hide": [
        "provinceview/province_window/loot_icon",
        "provinceview/province_window/loot_progress",
        "provinceview/province_window/loot_progress_frame",
        "provinceview/province_window/devastation_icon",
        "provinceview/province_window/devastation_value",
      ],
    },
    "foreign-province-actions": {
      "note": "What only the player's own provinces offer: coring, a client state, returning the province, colony growth, and its construction (Siroz in the corpus).",
      "when": { "owner": "no" },
      "hide": [
        "provinceview/province_window/add_core_button",
        "provinceview/province_window/client_state_button",
        "provinceview/province_window/return_province_button",
        "provinceview/province_window/settlement_growth_checkbox",
        "provinceview/province_window/progress_bar_window",
      ],
    },
    "hidden-foreign_province_window": {
      "note": "Shown while the player integrates or annexes the owner, its subject; show them by hand.",
      "hide": [
        "provinceview/province_window/foreign_province_window/annex_icon",
        "provinceview/province_window/foreign_province_window/integrate_icon",
        "provinceview/province_window/foreign_province_window/integrate_annex_progress",
        "provinceview/province_window/foreign_province_window/integrate_annex_progress_frame",
        "provinceview/province_window/foreign_province_window/cancel_integrate_annex_button",
      ],
    },
    "hre-own": {
      "when": { "hre": "yes", "owner": "yes" },
      "show": ["provinceview/province_window/hre_button"],
    },
    "hre-foreign": {
      "when": { "hre": "yes", "owner": "no" },
      "show": ["provinceview/province_window/hre_icon"],
    },
    "foreign-claim": {
      "note": "A foreign province offers to fabricate a claim (the corpus's Siroz).",
      "when": { "owner": "no" },
      "show": ["provinceview/province_window/claim_province_button"],
    },
    "hidden-progress_bar_window": {
      "note": "Hidden in the corpus captures while a ship is built: the mutual construction parts.",
      "hide": [
        "provinceview/province_window/progress_bar_window/mutually_cancel",
        "provinceview/province_window/progress_bar_window/mutually_progress",
        "provinceview/province_window/progress_bar_window/mutually_progress_frame",
        "provinceview/province_window/progress_bar_window/mutually_progress_icon",
      ],
    },
    "hidden-top_section_window": {
      "note": "The marks of the three slots, which the rules below show by the capital, trade port and parliament selectors; strait and river, which the map decides (etch#155).",
      "hide": [
        "provinceview/top_section_window/add_parliament",
        "provinceview/top_section_window/have_capital",
        "provinceview/top_section_window/have_parliament",
        "provinceview/top_section_window/have_trade_port",
        "provinceview/top_section_window/river_indicator",
        "provinceview/top_section_window/strait_indicator",
      ],
    },
    "capital": {
      "note": "The first slot of the top section: have_capital in the owner's capital, own or foreign (0x1349580).",
      "when": { "capital": "yes" },
      "show": ["provinceview/top_section_window/have_capital"],
      "hide": ["provinceview/top_section_window/move_capital"],
    },
    "trade-port": {
      "note": "The second slot: have_trade_port in the player's own trade port (0x134A530).",
      "when": { "tradePort": "yes", "owner": "yes" },
      "show": ["provinceview/top_section_window/have_trade_port"],
      "hide": ["provinceview/top_section_window/move_trade_port"],
    },
    "no-parliament": {
      "note": "The third slot stays empty where the player's country has no parliament (0x13497F0).",
      "when": { "parliament": "none" },
      "hide": ["provinceview/top_section_window/remove_parliament"],
    },
    "no-seat": {
      "when": { "parliament": "noSeat" },
      "show": ["provinceview/top_section_window/add_parliament"],
      "hide": ["provinceview/top_section_window/remove_parliament"],
    },
    "foreign-top-section": {
      "note": "Moving the capital or the trade port and the parliament seat are the player's own provinces' (0x1349580, 0x134A530, 0x13497F0).",
      "when": { "owner": "no" },
      "hide": [
        "provinceview/top_section_window/move_capital",
        "provinceview/top_section_window/move_trade_port",
        "provinceview/top_section_window/have_trade_port",
        "provinceview/top_section_window/add_parliament",
        "provinceview/top_section_window/remove_parliament",
      ],
    },
    "hidden-province_values_window": {
      "note": "The revolution's parts, shown in a centre of revolution.",
      "hide": [
        "provinceview/buildings_window/province_values_window/center_of_revolution",
        "provinceview/buildings_window/province_values_window/center_of_revolution_label",
        "provinceview/buildings_window/province_values_window/revolution_progress",
        "provinceview/buildings_window/province_values_window/revolution_progress_frame",
        "provinceview/buildings_window/province_values_window/revolution_progress_label",
        "provinceview/buildings_window/province_values_window/revolution_spread",
        "provinceview/buildings_window/province_values_window/spreaded_revolution_label",
        "provinceview/buildings_window/province_values_window/spreading_revolution_label",
        "provinceview/buildings_window/province_values_window/spreading_to_provinces_label",
      ],
    },
    "hidden-general_buildings_window": {
      "note": "Shown where the centre of trade can be upgraded; show it by hand.",
      "hide": ["provinceview/buildings_window/general_buildings_window/center_of_trade_button"],
    },
    "no-center-of-trade": {
      "when": { "centerOfTrade": "no" },
      "hide": ["provinceview/buildings_window/general_buildings_window/center_of_trade_icon"],
    },
  },
  "views": {
    "own": {
      "label": "Own province",
      "set": { "owner": "yes", "tab": "province", "side": "buildings", "subPanel": "none" },
    },
    "foreign": {
      "label": "Foreign province",
      "set": { "owner": "no", "tab": "province", "side": "buildings", "subPanel": "none" },
    },
    "state": {
      "label": "State tab",
      "set": { "owner": "yes", "tab": "state", "side": "none", "subPanel": "none" },
    },
    "build-army": {
      "label": "Build army",
      "set": {
        "owner": "yes",
        "tab": "province",
        "side": "buildings",
        "subPanel": "build_army_view",
      },
    },
    "build-navy": {
      "label": "Build navy",
      "set": {
        "owner": "yes",
        "tab": "province",
        "side": "buildings",
        "subPanel": "build_navy_view",
      },
    },
    "change-culture": {
      "label": "Change culture",
      "set": {
        "owner": "yes",
        "tab": "province",
        "side": "buildings",
        "subPanel": "change_culture_view",
      },
    },
  },
  "defaultView": "own",
}
