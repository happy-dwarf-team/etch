// The countrydiplomacyview window of the base game (spec v2 section 11, docs/window-profiles.md).
// Its rules hide what the precision corpus captures show hidden; they were drafted from the
// captures and are checked by them (ADR 0006).
{
  "formatVersion": 1,
  "window": "countrydiplomacyview",
  "checkedWith": "1.37.5",
  "selectors": {
    "country": {
      "kind": "ui",
      "label": "Country",
      "values": { "own": "The player's", "other": "Another country" },
      "note": "The country whose shield the player clicked. The coverage survey shows the action list and the relation to the player for another country, and the relations list for the player's.",
    },
    "religionIcon": {
      "kind": "data",
      "label": "Religion icon",
      "fact": "country.religionIcon",
      "values": { "none": "None", "secondary": "Secondary religion", "school": "Religious school" },
      "note": "eu4.exe shows the country's secondary religion, else with Cradle of Civilization its religious school, else neither, and then moves label_nation and label_fog 20 px left (GOG 1.37.5.2 0xEFC380, 0xEFC40D).",
    },
    "heir": {
      "kind": "ui",
      "label": "Heir",
      "values": {
        "yes": "Heir",
        "no": "No heir",
        "elective": "Elective",
        "hidden": "No heir line",
      },
      "default": "yes",
      "note": "Without an heir the game keeps monarch_heir_name (its text says so) and hides the heir's label, gender and age (the coverage survey: Russia has an heir, Anbennar's Verne, the Celestial Emperor and the first great power of 1444 have none). An elective country shows election_info in place of the heir's name (Kobildzan, 1594); Kobildzan's view of the Celestial Emperor shows neither the heir's line nor election_info.",
    },
    "rivals": {
      "kind": "ui",
      "label": "Rivals",
      "values": { "possible": "Possible", "notPossible": "Not possible" },
      "default": "notPossible",
      "note": "The player's own country shows its rivals and enemies, or label_rivals_not_possible when it cannot choose rivals (the coverage survey: Verne can; Russia in 1719 and Kobildzan cannot).",
    },
    "hreMember": {
      "kind": "ui",
      "label": "Empire member",
      "values": { "yes": "Member", "no": "Not a member" },
      "default": "no",
      "note": "member_of_HRE shows for a member of the Holy Roman Empire (the coverage survey: Anbennar's emperor in 1444).",
    },
  },
  "groups": {
    "religionIcon": {
      "label": "Religion icon",
      "selector": "religionIcon",
      "none": true,
      "members": {
        "secondary": "countrydiplomacyview/secondary_religion_icon",
        "school": "countrydiplomacyview/religious_school_icon",
      },
    },
  },
  "rules": {
    "labels-without-religion-icon": {
      "when": { "religionIcon": "none" },
      "offset": {
        "countrydiplomacyview/label_nation": { "x": -20 },
        "countrydiplomacyview/label_fog": { "x": -20 },
      },
    },
    "hidden": {
      "note": "Hidden in the corpus capture of \"diplomacy\" in vanilla (Russia, 17 March 1719): the game decides these from its data or a click; show one by hand.",
      "hide": [
        "countrydiplomacyview/diplomacy_favors_progress_bar",
        "countrydiplomacyview/diplomacy_favors_progress_frame",
        "countrydiplomacyview/diplomacy_favors_progress_indicator",
        "countrydiplomacyview/diplomacy_trust_progress_bar",
        "countrydiplomacyview/diplomacy_trust_progress_frame",
        "countrydiplomacyview/diplomacy_trust_progress_indicator",
        "countrydiplomacyview/domesticpanel_bg_top",
        "countrydiplomacyview/election_info",
        "countrydiplomacyview/favors_label",
        "countrydiplomacyview/favors_value",
        "countrydiplomacyview/feedback_bg",
        "countrydiplomacyview/friendly_checkbox",
        "countrydiplomacyview/friendly_icon",
        "countrydiplomacyview/friendly_label",
        "countrydiplomacyview/hostile_checkbox",
        "countrydiplomacyview/hostile_icon",
        "countrydiplomacyview/hostile_label",
        "countrydiplomacyview/join_offensive_wars_checkbox",
        "countrydiplomacyview/label_enemies",
        "countrydiplomacyview/label_rivals",
        "countrydiplomacyview/manual_manage_checkbox",
        "countrydiplomacyview/manual_manage_label",
        "countrydiplomacyview/member_of_HRE",
        "countrydiplomacyview/neutral_checkbox",
        "countrydiplomacyview/neutral_icon",
        "countrydiplomacyview/neutral_label",
        "countrydiplomacyview/provincelist",
        "countrydiplomacyview/provincelist_desc",
        "countrydiplomacyview/provincelist_label",
        "countrydiplomacyview/select_rivals_window",
        "countrydiplomacyview/threat_checkbox",
        "countrydiplomacyview/threat_label",
        "countrydiplomacyview/threatened_icon",
        "countrydiplomacyview/trust_label",
        "countrydiplomacyview/trust_value",
        "countrydiplomacyview/vassal_select_window",
      ],
    },
    "no-heir": {
      "when": { "heir": "no" },
      "hide": [
        "countrydiplomacyview/heir_gender",
        "countrydiplomacyview/monarch_heir_label",
        "countrydiplomacyview/monarch_heir_info",
      ],
    },
    "no-heir-line": {
      "when": { "heir": "hidden" },
      "hide": [
        "countrydiplomacyview/heir_gender",
        "countrydiplomacyview/monarch_heir_label",
        "countrydiplomacyview/monarch_heir_name",
        "countrydiplomacyview/monarch_heir_info",
      ],
    },
    "elective": {
      "when": { "heir": "elective" },
      "show": ["countrydiplomacyview/election_info"],
      "hide": [
        "countrydiplomacyview/heir_gender",
        "countrydiplomacyview/monarch_heir_label",
        "countrydiplomacyview/monarch_heir_name",
        "countrydiplomacyview/monarch_heir_info",
      ],
    },
    "own-rivals": {
      "when": { "country": "own", "rivals": "possible" },
      "show": ["countrydiplomacyview/label_enemies", "countrydiplomacyview/label_rivals"],
      "hide": ["countrydiplomacyview/label_rivals_not_possible"],
    },
    "own-rivals-not-possible": {
      "when": { "country": "own", "rivals": "notPossible" },
      "show": ["countrydiplomacyview/label_rivals_not_possible"],
      "hide": ["countrydiplomacyview/label_enemies", "countrydiplomacyview/label_rivals"],
    },
    "hre-member": {
      "when": { "hreMember": "yes" },
      "show": ["countrydiplomacyview/member_of_HRE"],
    },
    "own-country": {
      "when": { "country": "own" },
      "hide": [
        "countrydiplomacyview/attitude_icons_strip",
        "countrydiplomacyview/attitude_icons_strip02",
        "countrydiplomacyview/button_view_player_country",
        "countrydiplomacyview/diploaction_list",
        "countrydiplomacyview/relation_bg",
        "countrydiplomacyview/relation_bg_2",
        "countrydiplomacyview/relation_value",
        "countrydiplomacyview/relation_value_2",
      ],
    },
    "other-country": {
      "when": { "country": "other" },
      "show": ["countrydiplomacyview/label_enemies", "countrydiplomacyview/label_rivals"],
      "hide": [
        "countrydiplomacyview/button_createvassals",
        "countrydiplomacyview/diploopinion_list",
        "countrydiplomacyview/improve_relation_bg",
        "countrydiplomacyview/improve_relation_icon",
        "countrydiplomacyview/improve_relation_value",
        "countrydiplomacyview/label_rivals_not_possible",
        "countrydiplomacyview/num_relations_bg",
        "countrydiplomacyview/num_relations_icon",
        "countrydiplomacyview/num_relations_value",
        "countrydiplomacyview/reputation_bg",
        "countrydiplomacyview/reputation_icon",
        "countrydiplomacyview/reputation_value",
        "countrydiplomacyview/sort_name",
        "countrydiplomacyview/sort_opinion",
        "countrydiplomacyview/sort_opinion_1",
        "countrydiplomacyview/sort_opinion_2",
        "countrydiplomacyview/sort_opinion_3",
        "countrydiplomacyview/sort_opinion_4",
        "countrydiplomacyview/sort_opinion_5",
        "countrydiplomacyview/sort_search",
        "countrydiplomacyview/sort_search_edit",
      ],
    },
  },
  "repeaters": {
    "countrydiplomacyview/diploaction_list": {
      "note": "The list as it opens: the game's categories, one row below its first row, Declare War, which has another template (the coverage survey: 8 categories in vanilla and Anbennar).",
      "template": "diploactionentry_category",
      "count": 8,
      "place": { "start": { "x": 0, "y": 26 }, "step": { "x": 0, "y": 26 } },
    },
  },
  "content": {
    "countrydiplomacyview/num_relations_value": {
      "engine": true,
      "generated": "integer",
      "note": "The game's code writes the relations in use over the limit, as 2/7, in place of the file's \"+155 ???\", which does not fit the box's 44 px and wraps (the coverage survey: one line, 44×26, in every playset).",
    },
  },
}
