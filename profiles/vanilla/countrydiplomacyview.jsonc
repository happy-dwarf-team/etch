// The countrydiplomacyview window of the base game (spec v2 section 11, docs/window-profiles.md).
// Its rules hide what the precision corpus captures show hidden; they were drafted from the
// captures and are checked by them (ADR 0006).
{
  "formatVersion": 1,
  "window": "countrydiplomacyview",
  "checkedWith": "1.37.5",
  "selectors": {
    "religionIcon": {
      "kind": "data",
      "label": "Religion icon",
      "fact": "country.religionIcon",
      "values": { "none": "None", "secondary": "Secondary religion", "school": "Religious school" },
      "note": "eu4.exe shows the country's secondary religion, else with Cradle of Civilization its religious school, else neither, and then moves label_nation and label_fog 20 px left (GOG 1.37.5.2 0xEFC380, 0xEFC40D).",
    },
  },
  "groups": {
    "religionIcon": {
      "label": "Religion icon",
      "selector": "religionIcon",
      "none": true,
      "members": {
        "secondary": "countrydiplomacyview/secondary_religion_icon",
        "school": "countrydiplomacyview/religious_school_icon",
      },
    },
  },
  "rules": {
    "labels-without-religion-icon": {
      "when": { "religionIcon": "none" },
      "offset": {
        "countrydiplomacyview/label_nation": { "x": -20 },
        "countrydiplomacyview/label_fog": { "x": -20 },
      },
    },
    "hidden": {
      "note": "Hidden in the corpus capture of \"diplomacy\" in vanilla (Russia, 17 March 1719): the game decides these from its data or a click; show one by hand.",
      "hide": [
        "countrydiplomacyview/attitude_icons_strip",
        "countrydiplomacyview/attitude_icons_strip02",
        "countrydiplomacyview/button_view_player_country",
        "countrydiplomacyview/diploaction_list",
        "countrydiplomacyview/diplomacy_favors_progress_bar",
        "countrydiplomacyview/diplomacy_favors_progress_frame",
        "countrydiplomacyview/diplomacy_favors_progress_indicator",
        "countrydiplomacyview/diplomacy_trust_progress_bar",
        "countrydiplomacyview/diplomacy_trust_progress_frame",
        "countrydiplomacyview/diplomacy_trust_progress_indicator",
        "countrydiplomacyview/domesticpanel_bg_top",
        "countrydiplomacyview/election_info",
        "countrydiplomacyview/favors_label",
        "countrydiplomacyview/favors_value",
        "countrydiplomacyview/feedback_bg",
        "countrydiplomacyview/friendly_checkbox",
        "countrydiplomacyview/friendly_icon",
        "countrydiplomacyview/friendly_label",
        "countrydiplomacyview/hostile_checkbox",
        "countrydiplomacyview/hostile_icon",
        "countrydiplomacyview/hostile_label",
        "countrydiplomacyview/join_offensive_wars_checkbox",
        "countrydiplomacyview/label_enemies",
        "countrydiplomacyview/label_rivals",
        "countrydiplomacyview/manual_manage_checkbox",
        "countrydiplomacyview/manual_manage_label",
        "countrydiplomacyview/member_of_HRE",
        "countrydiplomacyview/neutral_checkbox",
        "countrydiplomacyview/neutral_icon",
        "countrydiplomacyview/neutral_label",
        "countrydiplomacyview/provincelist",
        "countrydiplomacyview/provincelist_desc",
        "countrydiplomacyview/provincelist_label",
        "countrydiplomacyview/relation_bg",
        "countrydiplomacyview/relation_bg_2",
        "countrydiplomacyview/relation_value",
        "countrydiplomacyview/relation_value_2",
        "countrydiplomacyview/select_rivals_window",
        "countrydiplomacyview/threat_checkbox",
        "countrydiplomacyview/threat_label",
        "countrydiplomacyview/threatened_icon",
        "countrydiplomacyview/trust_label",
        "countrydiplomacyview/trust_value",
        "countrydiplomacyview/vassal_select_window",
      ],
    },
  },
}
