// The countrystabilityview window of the base game (docs/window-profiles.md). Its rule hides what the coverage
// survey's 6 captures of it show hidden; drafted from them, as the corpus's are (ADR 0006).
{
  "formatVersion": 1,
  "window": "countrystabilityview",
  "checkedWith": "1.37.5",
  "selectors": {
    "stability": {
      "kind": "ui",
      "label": "Stability",
      "values": {
        "minus3": "-3",
        "minus2": "-2",
        "minus1": "-1",
        "zero": "0",
        "plus1": "+1",
        "plus2": "+2",
        "plus3": "+3",
      },
      "default": "zero",
      "note": "CCountryStabilityView::OnDailyUpdate (eu4.exe 0xF87E80) moves stability_progress_threshold and stability_value from their .gui place by the x of the positionType stability_progress_threshold_move (16 px here) times the stability (the coverage survey: 0 in Anbennar's Verne at x 84, +3 in Russia 1719 at x 132).",
    },
    "handleRebels": {
      "kind": "ui",
      "label": "Handle rebels",
      "values": { "closed": "Closed", "open": "Open" },
      "default": "closed",
      "note": "A rebel faction's handlethem button opens cv_governmentrebels_handlerebels (the coverage survey, vanilla and Anbennar: closed as the tab opens).",
    },
  },
  "rules": {
    "stability-minus3": {
      "when": { "stability": "minus3" },
      "offset": {
        "countrystabilityview/stability_progress_threshold": { "x": -48 },
        "countrystabilityview/stability_value": { "x": -48 },
      },
    },
    "stability-minus2": {
      "when": { "stability": "minus2" },
      "offset": {
        "countrystabilityview/stability_progress_threshold": { "x": -32 },
        "countrystabilityview/stability_value": { "x": -32 },
      },
    },
    "stability-minus1": {
      "when": { "stability": "minus1" },
      "offset": {
        "countrystabilityview/stability_progress_threshold": { "x": -16 },
        "countrystabilityview/stability_value": { "x": -16 },
      },
    },
    "stability-plus1": {
      "when": { "stability": "plus1" },
      "offset": {
        "countrystabilityview/stability_progress_threshold": { "x": 16 },
        "countrystabilityview/stability_value": { "x": 16 },
      },
    },
    "stability-plus2": {
      "when": { "stability": "plus2" },
      "offset": {
        "countrystabilityview/stability_progress_threshold": { "x": 32 },
        "countrystabilityview/stability_value": { "x": 32 },
      },
    },
    "stability-plus3": {
      "when": { "stability": "plus3" },
      "offset": {
        "countrystabilityview/stability_progress_threshold": { "x": 48 },
        "countrystabilityview/stability_value": { "x": 48 },
      },
    },
    "handle-rebels-closed": {
      "when": { "handleRebels": "closed" },
      "hide": ["countrystabilityview/cv_governmentrebels_handlerebels"],
    },
    "hidden": {
      "note": "Hidden in every view of the coverage survey (the base game): the game decides these from its data or a click; show one by hand.",
      "hide": [
        "countrystabilityview/cv_governmentrebels_handlerebels/rebels_progress",
        "countrystabilityview/manage_overext_window",
        "countrystabilityview/warex_development_value",
      ],
    },
  },
  "content": {
    "countrystabilityview/cv_governmentrebels_handlerebels/onsiegewon_desc": {
      "engine": true,
      "sizedBy": "REB_NO_EFFECT",
      "note": "What the rebels do when they win a siege. CCountryHandleRebelsView::OnDailyUpdate (eu4.exe 0xF9B290) sets REB_NO_EFFECT first with the height left open, so the box is one line high, and the rebels' effect after it ends in \" ...\" (the coverage survey's capture).",
    },
  },
}
