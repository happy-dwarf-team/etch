// The countrygovernmentview window of the base game (docs/window-profiles.md). Its rule hides what the coverage
// survey's 6 captures of it show hidden; drafted from them, as the corpus's are (ADR 0006).
{
  "formatVersion": 1,
  "window": "countrygovernmentview",
  "checkedWith": "1.37.5",
  "selectors": {
    "mechanics": {
      "kind": "ui",
      "label": "Government mechanics",
      "values": { "shown": "Shown", "none": "None" },
      "note": "Russia's game shows the government mechanics' list, France's does not (the coverage survey, etch#258).",
    },
    "revolutionSpread": {
      "kind": "ui",
      "label": "Revolution spread",
      "values": { "shown": "Shown", "none": "None" },
      "note": "The bar is shown in 1719 and not in 1550 (the coverage survey, etch#258); what decides it is not read in the code.",
    },
    "reformChoice": {
      "kind": "ui",
      "label": "Reform choice",
      "values": { "closed": "Closed", "open": "Open" },
      "default": "closed",
      "note": "The top bar's government reforms button opens the tab with gov_view_reform_select beside it: the game then shows bg_top instead of the full background and hides the culture lists. The country view's government tab opens it closed (the coverage survey, Russia 1719 and Verne 1444).",
    },
  },
  "rules": {
    "reform-choice-closed": {
      "when": { "reformChoice": "closed" },
      "hide": ["countrygovernmentview/bg_top"],
    },
    "reform-choice-open": {
      "when": { "reformChoice": "open" },
      "hide": [
        "countrygovernmentview/background",
        "countrygovernmentview/cultures_window/accepted_culture_slots",
        "countrygovernmentview/cultures_window/accepted_cultures_listbox",
        "countrygovernmentview/cultures_window/non_accepted_cultures_listbox",
      ],
    },
    "no-mechanics": {
      "when": { "mechanics": "none" },
      "hide": [
        "countrygovernmentview/government_mechanics_bg",
        "countrygovernmentview/specific_governments_list",
      ],
    },
    "no-revolution-spread": {
      "when": { "revolutionSpread": "none" },
      "hide": [
        "countrygovernmentview/revolution_spread_bad_bar",
        "countrygovernmentview/revolution_spread_frame",
        "countrygovernmentview/revolution_spread_icon",
      ],
    },
    "hidden": {
      "note": "Hidden in every view of the coverage survey (the base game): the game decides these from its data or a click; show one by hand.",
      "hide": [
        "countrygovernmentview/assimilated_cultures_window",
        "countrygovernmentview/claim_revolution_button",
        "countrygovernmentview/claim_revolution_icon",
        "countrygovernmentview/icon_government_desc_1",
        "countrygovernmentview/icon_government_desc_2",
        "countrygovernmentview/icon_government_desc_3",
        "countrygovernmentview/max_revolutionary_zeal_icon",
        "countrygovernmentview/max_revolutionary_zeal_value",
        "countrygovernmentview/modifier_view",
        "countrygovernmentview/revolution_spread_button",
        "countrygovernmentview/revolution_spread_good_bar",
        "countrygovernmentview/revolution_target_icon",
        "countrygovernmentview/revolutionary_zeal_icon",
        "countrygovernmentview/revolutionary_zeal_value",
      ],
    },
  },
}
