// The hre_window window of the base game (docs/window-profiles.md). Its rule hides what the coverage
// survey's 3 captures of it show hidden; drafted from them, as the corpus's are (ADR 0006).
{
  "formatVersion": 1,
  "window": "hre_window",
  "checkedWith": "1.37.5",
  "rules": {
    "hidden": {
      "note": "Hidden in every view of the coverage survey (the base game): the game decides these from its data or a click; show one by hand.",
      "hide": [
        "hre_window/feature_window",
        "hre_window/hre_bg_extended",
        "hre_window/hre_heretic_league",
        "hre_window/hre_heretic_religion_icon",
        "hre_window/hre_league",
        "hre_window/hre_religion_icon",
        "hre_window/hre_status_icon",
        "hre_window/hre_war_peace_icon",
        "hre_window/join_heretic_league_button",
        "hre_window/join_league_button",
        "hre_window/vote_button",
      ],
    },
  },
}
