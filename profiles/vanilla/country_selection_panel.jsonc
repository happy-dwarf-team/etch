// The country_selection_panel window of the base game (spec v2 section 11, docs/window-profiles.md).
// Its rules hide what the precision corpus captures show hidden; they were drafted from the
// captures and are checked by them (ADR 0006).
{
  "formatVersion": 1,
  "window": "country_selection_panel",
  "checkedWith": "1.37.5",
  "selectors": {
    "page": {
      "kind": "ui",
      "label": "Page",
      "values": {
        "main-menu": "Main menu",
        "lobby": "Single-player lobby",
        "nation-designer": "Nation designer",
        "credits": "Credits",
        "settings": "Settings",
      },
    },
    "continueGame": {
      "kind": "ui",
      "label": "Continue game",
      "values": { "no": "No save", "yes": "A save to continue" },
      "note": "Whether the main menu offers to continue a game: it depends on the player's saves.",
    },
    "country": {
      "kind": "ui",
      "label": "Country",
      "values": { "none": "None chosen", "chosen": "Chosen" },
      "note": "Whether the player has chosen a country in the single-player lobby: the coverage survey shows the country's panel in place of no_player.",
    },
    "religionIcon": {
      "kind": "data",
      "label": "Religion icon",
      "fact": "country.religionIcon",
      "values": { "none": "None", "secondary": "Secondary religion", "school": "Religious school" },
      "note": "The lobby's country panel shows the chosen country's secondary religion; without one eu4.exe hides secondary_religion_icon and moves religion_icon 18 px down (Steam 1.37.5 0x11199A0). The lobby shows no religious school, so a school counts as none.",
    },
  },
  "rules": {
    "lobby-no-country": {
      "when": { "page": ["lobby", "nation-designer"], "country": "none" },
      "hide": ["country_selection_panel/lobby/right/singleplayer"],
    },
    "lobby-country": {
      "when": { "page": ["lobby", "nation-designer"], "country": "chosen" },
      "hide": ["country_selection_panel/lobby/right/no_player"],
    },
    "no-secondary-religion": {
      "when": { "religionIcon": ["none", "school"] },
      "hide": ["country_selection_panel/lobby/right/singleplayer/secondary_religion_icon"],
      "offset": { "country_selection_panel/lobby/right/singleplayer/religion_icon": { "y": 18 } },
    },
    "hidden": {
      "note": "Hidden in the corpus capture of \"lobby\" and \"main-menu\" in vanilla (Russia, 17 March 1719): the game decides these from its data or a click; show one by hand.",
      "hide": [
        "country_selection_panel/Background",
        "country_selection_panel/mainmenu_panel_top",
        "country_selection_panel/multiplayer_connect_menu",
        "country_selection_panel/multiplayer_menu",
        "country_selection_panel/settings",
        "country_selection_panel/tutorial_panel",
      ],
    },
    "hidden-mainmenu": {
      "note": "Hidden in the corpus capture of \"lobby\" and \"main-menu\" in vanilla (Russia, 17 March 1719): the game decides these from its data or a click; show one by hand.",
      "hide": ["country_selection_panel/mainmenu/new_content"],
    },
    "hidden-lobby-bottom-on-lobby": {
      "note": "Hidden in the corpus capture of \"lobby\" and \"main-menu\" in vanilla (Russia, 17 March 1719): the game decides these from its data or a click; show one by hand.",
      "when": {
        "page": ["lobby", "nation-designer"],
      },
      "hide": [
        "country_selection_panel/lobby/bottom/chatlog",
        "country_selection_panel/lobby/bottom/largefonts_lobby_chat_edit",
        "country_selection_panel/lobby/bottom/lobby_chat_button",
        "country_selection_panel/lobby/bottom/lobby_chat_edit",
        "country_selection_panel/lobby/bottom/mic_button",
        "country_selection_panel/lobby/bottom/speech_enabled_largefonts_lobby_chat_edit",
        "country_selection_panel/lobby/bottom/speech_enabled_lobby_chat_button",
        "country_selection_panel/lobby/bottom/speech_enabled_lobby_chat_edit",
      ],
    },
    "hidden-lobby-left-on-lobby": {
      "note": "Hidden in the corpus capture of \"lobby\" and \"main-menu\" in vanilla (Russia, 17 March 1719): the game decides these from its data or a click; show one by hand.",
      "when": {
        "page": ["lobby", "nation-designer"],
      },
      "hide": [
        "country_selection_panel/lobby/left/lessons",
        "country_selection_panel/lobby/left/observe_mode_button",
        "country_selection_panel/lobby/left/observe_mode_title",
        "country_selection_panel/lobby/left/save_games",
      ],
    },
    "hidden-lobby-on-lobby": {
      "note": "Hidden in the corpus capture of \"lobby\" and \"main-menu\" in vanilla (Russia, 17 March 1719): the game decides these from its data or a click; show one by hand.",
      "when": {
        "page": ["lobby", "nation-designer"],
      },
      "hide": [
        "country_selection_panel/lobby/nation_designer_bottom_panel",
        "country_selection_panel/lobby/random_new_world_loading_window",
      ],
    },
    "hidden-lobby-right-on-lobby": {
      "note": "Hidden in the corpus capture of \"lobby\" and \"main-menu\" in vanilla (Russia, 17 March 1719): the game decides these from its data or a click; show one by hand.",
      "when": {
        "page": ["lobby", "nation-designer"],
      },
      "hide": [
        "country_selection_panel/lobby/right/country_tab",
        "country_selection_panel/lobby/right/country_tab_title",
        "country_selection_panel/lobby/right/enable_custom_nation_button",
        "country_selection_panel/lobby/right/ironman_icon",
        "country_selection_panel/lobby/right/ironman_label",
        "country_selection_panel/lobby/right/multiplayer",
        "country_selection_panel/lobby/right/observe_mode_button",
        "country_selection_panel/lobby/right/observe_mode_title",
        "country_selection_panel/lobby/right/players_tab",
        "country_selection_panel/lobby/right/players_tab_title",
      ],
    },
    "hidden-lobby-top-on-lobby": {
      "note": "Hidden in the corpus capture of \"lobby\" and \"main-menu\" in vanilla (Russia, 17 March 1719): the game decides these from its data or a click; show one by hand.",
      "when": {
        "page": ["lobby", "nation-designer"],
      },
      "hide": [
        "country_selection_panel/lobby/top/mapmode_content",
        "country_selection_panel/lobby/top/mapmode_expansion",
        "country_selection_panel/lobby/top/mapmode_music",
        "country_selection_panel/lobby/top/mapmode_players",
        "country_selection_panel/lobby/top/mapmode_unit",
      ],
    },
    "lobby-only": {
      "when": { "page": "lobby" },
      "hide": [
        "country_selection_panel/lobby/top/nation_designer_hint",
        "country_selection_panel/lobby/top/nation_designer_hint_bg",
      ],
    },
    "nation-designer-hint": {
      "note": "In the nation designer the game's code writes FE_SELECT_CUSTOM_NATION_CAPITAL in nation_designer_hint, whose .gui text NATION_DESIGNER_HINT has no localisation (the coverage survey's nation designer, Proper 2K UI Enhanced and the P2KE playset: two lines in 384 px).",
      "when": { "page": "nation-designer" },
      "text": {
        "country_selection_panel/lobby/top/nation_designer_hint": "FE_SELECT_CUSTOM_NATION_CAPITAL",
      },
    },
    "nation-designer": {
      "note": "Hidden in the nation designer in the coverage survey.",
      "when": { "page": "nation-designer" },
      "hide": [
        "country_selection_panel/lobby/bottom",
        "country_selection_panel/lobby/left",
        "country_selection_panel/lobby/right/play_button",
        "country_selection_panel/lobby/right/random_country_button",
        "country_selection_panel/lobby/right/random_new_world_button",
        "country_selection_panel/lobby/top/select_label",
      ],
    },
    "hidden-mainmenu-on-lobby": {
      "note": "Hidden in the corpus capture of \"lobby\" and \"main-menu\" in vanilla (Russia, 17 March 1719): the game decides these from its data or a click; show one by hand.",
      "when": {
        "page": ["lobby", "nation-designer", "credits", "settings"],
      },
      "hide": [
        "country_selection_panel/mainmenu/PersistentSocialButtons",
        "country_selection_panel/mainmenu/mainmenu_panel_bottom",
        "country_selection_panel/mainmenu/mainmenu_panel_upperleft",
        "country_selection_panel/mainmenu/mainmenu_panel_upperright",
      ],
    },
    "hidden-on-main-menu": {
      "note": "Hidden in the corpus capture of \"lobby\" and \"main-menu\" in vanilla (Russia, 17 March 1719): the game decides these from its data or a click; show one by hand.",
      "when": {
        "page": ["main-menu", "credits", "settings"],
      },
      "hide": ["country_selection_panel/lobby"],
    },
    "hidden-mainmenu-mainmenu_panel_bottom-on-main-menu": {
      "note": "Hidden in the corpus capture of \"lobby\" and \"main-menu\" in vanilla (Russia, 17 March 1719): the game decides these from its data or a click; show one by hand.",
      "when": {
        "page": "main-menu",
      },
      "hide": [
        "country_selection_panel/mainmenu/mainmenu_panel_bottom/continue_container/ironman_icon",
        "country_selection_panel/mainmenu/mainmenu_panel_bottom/nudge_button",
      ],
    },
    "national-idea-icons": {
      "note": "eu4.exe gives the lobby's seven national idea icons GFX_idea_unknown, with the idea's own picture as its texture, in place of the .gui's GFX_idea_empty: the coverage survey's lobby captures of 24 November 2026 show it in every playset. Both are 64 × 64 in the base game; Proper 2K UI Enhanced's unknown.dds is a 77 × 77 DXT5 image, drawn 80 × 80 and so 52 × 52 at the .gui's scale 0.66, where its empty.tga gives 50 × 50.",
      "sprite": {
        "country_selection_panel/lobby/right/singleplayer/national_idea1": "GFX_idea_unknown",
        "country_selection_panel/lobby/right/singleplayer/national_idea2": "GFX_idea_unknown",
        "country_selection_panel/lobby/right/singleplayer/national_idea3": "GFX_idea_unknown",
        "country_selection_panel/lobby/right/singleplayer/national_idea4": "GFX_idea_unknown",
        "country_selection_panel/lobby/right/singleplayer/national_idea5": "GFX_idea_unknown",
        "country_selection_panel/lobby/right/singleplayer/national_idea6": "GFX_idea_unknown",
        "country_selection_panel/lobby/right/singleplayer/national_idea7": "GFX_idea_unknown",
      },
    },
    "version-label": {
      "note": "eu4.exe writes its version and the playset's checksum in the main menu's version_label, \"EU4 v1.37.5.0 Inca (491d)\" in the coverage survey of 24 November 2026, two lines in the .gui's 147 px. The checksum differs by playset: 0000 stands in for it.",
      "text": {
        "country_selection_panel/mainmenu/mainmenu_panel_bottom/version_label": {
          "literal": "EU4 v1.37.5.0 Inca (0000)",
        },
      },
    },
    "no-game-to-continue": {
      "when": { "page": "main-menu", "continueGame": "no" },
      "hide": ["country_selection_panel/mainmenu/mainmenu_panel_bottom/continue_container"],
    },
  },
  "content": {
    "country_selection_panel/lobby/bottom/scenario_description": {
      "loc": "RISE_OF_THE_OTTOMANS_DESC",
      "note": "The lobby describes the chosen bookmark; it opens on the bookmark with default = yes in common/bookmarks, the Rise of the Ottomans (the coverage survey's lobby views of 24 November 2026).",
    },
  },
  "views": {
    "main-menu": {
      "label": "Main menu",
      "set": {
        "page": "main-menu",
      },
    },
    "lobby": {
      "label": "Single-player lobby",
      "set": {
        "page": "lobby",
      },
    },
  },
}
