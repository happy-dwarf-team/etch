// The country_selection_panel window of the base game (spec v2 section 11, docs/window-profiles.md).
// Its rules hide what the precision corpus captures show hidden; they were drafted from the
// captures and are checked by them (ADR 0006).
{
  "formatVersion": 1,
  "window": "country_selection_panel",
  "checkedWith": "1.37.5",
  "selectors": {
    "page": {
      "kind": "ui",
      "label": "Page",
      "values": {
        "main-menu": "Main menu",
        "lobby": "Single-player lobby",
      },
    },
  },
  "rules": {
    "hidden": {
      "note": "Hidden in the corpus capture of \"lobby\" and \"main-menu\" in vanilla (Russia, 17 March 1719): the game decides these from its data or a click; show one by hand.",
