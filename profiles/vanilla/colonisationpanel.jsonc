// The colonisationpanel window of the base game (docs/window-profiles.md). Its rule hides what the coverage
// survey's 1 captures of it show hidden; drafted from them, as the corpus's are (ADR 0006).
{
  "formatVersion": 1,
  "window": "colonisationpanel",
  "checkedWith": "1.37.5",
  "rules": {
    "hidden": {
      "note": "Hidden in every view of the coverage survey (the base game): the game decides these from its data or a click; show one by hand.",
      "hide": [
        "colonisationpanel/colonist_window",
        "colonisationpanel/controller_window",
        "colonisationpanel/no_colonist_window/add_tribal_land_button",
        "colonisationpanel/no_colonist_window/migrate_tribe_button",
        "colonisationpanel/no_colonist_window/settle_tribe_button",
        "colonisationpanel/no_colonist_window/tribal_owner",
        "colonisationpanel/present_envoy_window",
        "colonisationpanel/select_minority_culture_window",
        "colonisationpanel/strait_indicator",
      ],
    },
  },
  "repeaters": {
    "colonisationpanel/modifiers": {
      "note": "The province's modifiers (province_modifier_item of provinceview.gui), from the box's left and overlapping when more do not fit (COverlappingElementsBox, eu4.exe 0x163D060; the survey's captures).",
      "template": "province_modifier_item",
      "from": "provinces.{province}.modifier",
      "count": 1,
    },
  },
}
