// The colonisationpanel window of the base game (docs/window-profiles.md). Its rule hides what the coverage
// survey's 1 captures of it show hidden; drafted from them, as the corpus's are (ADR 0006).
{
  "formatVersion": 1,
  "window": "colonisationpanel",
  "checkedWith": "1.37.5",
  "selectors": {
    "colonialRegion": {
      "kind": "data",
      "label": "Colonial region",
      "fact": "province.colonialRegion",
      "values": {
        "none": "None",
        "region": "In a region",
        "claimed": "Claimed by the Pope's grant",
      },
      "default": "none",
      "note": "What the game's code writes in region_text for an uncolonised province (eu4.exe 0xE31A50): nothing outside a colonial region; a line break, the region's name and a space in one; and \"Claimed by\" the country with its flag when the player's religion has a papacy and the Pope has granted the region. The map decides the region, so the save does not set it.",
    },
  },
  "rules": {
    "colonial-region": {
      "when": { "colonialRegion": "region" },
      "note": "Cascadia (colonial_alaska) without a grant, as the game writes it for Austria on 15 September 1550, province 978.",
      "text": {
        "colonisationpanel/no_colonist_window/region_text": [
          { "literal": "\n" },
          { "key": "colonial_alaska", "suffix": " " },
        ],
      },
    },
    "colonial-region-claimed": {
      "when": { "colonialRegion": "claimed" },
      "note": "Brazil granted to Portugal, as the game writes it for Austria, Aragon and C01 on 15 September 1550 (Amapá).",
      "text": {
        "colonisationpanel/no_colonist_window/region_text": [
          { "literal": "\n" },
          { "key": "colonial_brazil", "suffix": " " },
          { "key": "PAPAL_GRANT", "vars": { "WHO": { "key": "POR", "suffix": "(@POR)" } } },
        ],
      },
    },
    "hidden": {
      "note": "Hidden in every view of the coverage survey (the base game): the game decides these from its data or a click; show one by hand.",
      "hide": [
        "colonisationpanel/colonist_window",
        "colonisationpanel/controller_window",
        "colonisationpanel/no_colonist_window/add_tribal_land_button",
        "colonisationpanel/no_colonist_window/migrate_tribe_button",
        "colonisationpanel/no_colonist_window/settle_tribe_button",
        "colonisationpanel/no_colonist_window/tribal_owner",
        "colonisationpanel/present_envoy_window",
        "colonisationpanel/select_minority_culture_window",
        "colonisationpanel/strait_indicator",
      ],
    },
  },
  "repeaters": {
    "colonisationpanel/modifiers": {
      "note": "The province's modifiers (province_modifier_item of provinceview.gui), from the box's left and overlapping when more do not fit (eu4.exe 0x163D060; the survey's captures).",
      "template": "province_modifier_item",
      "from": "provinces.{province}.modifier",
      "count": 1,
    },
  },
}
