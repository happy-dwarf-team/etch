// The single_unitpanel window of the base game (docs/window-profiles.md). Its rules hide what the coverage
// survey's 3 captures of it show hidden (an army of Muscovy and of the Ottomans, a fleet of France);
// drafted from them, as the corpus's are (ADR 0006).
{
  "formatVersion": 1,
  "window": "single_unitpanel",
  "checkedWith": "1.37.5",
  "selectors": {
    "unit": {
      "kind": "ui",
      "label": "Unit",
      "values": { "army": "Army", "fleet": "Fleet" },
      "note": "The same panel shows an army or a fleet, with the other's buttons and rows hidden (the coverage survey's run of 6 November 2026).",
    },
  },
  "rules": {
    "an-army": {
      "when": { "unit": "army" },
      "hide": [
        "single_unitpanel/detach_obsolete_ships",
        "single_unitpanel/enable_autotransport_button",
        "single_unitpanel/enable_patrol_button",
        "single_unitpanel/evade_button",
        "single_unitpanel/home_at_war",
        "single_unitpanel/load_capacity",
        "single_unitpanel/mission_settings_button",
        "single_unitpanel/mothball_button",
        "single_unitpanel/nu_build_unit_1_button",
        "single_unitpanel/nu_build_unit_2_button",
        "single_unitpanel/nu_build_unit_3_button",
        "single_unitpanel/nu_build_unit_4_button",
        "single_unitpanel/nu_top_slots_bg",
        "single_unitpanel/nu_unit_type_1",
        "single_unitpanel/nu_unit_type_1_count",
        "single_unitpanel/nu_unit_type_2",
        "single_unitpanel/nu_unit_type_2_count",
        "single_unitpanel/nu_unit_type_3",
        "single_unitpanel/nu_unit_type_3_count",
        "single_unitpanel/nu_unit_type_4",
        "single_unitpanel/nu_unit_type_4_count",
        "single_unitpanel/raidslaves_button",
        "single_unitpanel/sailor_maintenance",
        "single_unitpanel/select_mission_button",
        "single_unitpanel/ship_load_capacity_bg",
        "single_unitpanel/toggle_foreign_armies_button",
        "single_unitpanel/upgrade_fleet_button",
      ],
    },
    "a-fleet": {
      "when": { "unit": "fleet" },
      "hide": [
        "single_unitpanel/army_drill_button",
        "single_unitpanel/attacknatives_button",
        "single_unitpanel/burncolony_button",
        "single_unitpanel/consolidate_button",
        "single_unitpanel/detach_marines_button",
        "single_unitpanel/enable_carpet_siege",
        "single_unitpanel/enable_force_march_button",
        "single_unitpanel/enable_rebel_button",
        "single_unitpanel/goto_siege_button",
        "single_unitpanel/lu_build_unit_1_button",
        "single_unitpanel/lu_build_unit_2_button",
        "single_unitpanel/lu_build_unit_3_button",
        "single_unitpanel/lu_unit_type_1",
        "single_unitpanel/lu_unit_type_1_count",
        "single_unitpanel/lu_unit_type_1_value",
        "single_unitpanel/lu_unit_type_2",
        "single_unitpanel/lu_unit_type_2_count",
        "single_unitpanel/lu_unit_type_2_value",
        "single_unitpanel/lu_unit_type_3",
        "single_unitpanel/lu_unit_type_3_count",
        "single_unitpanel/lu_unit_type_3_value",
        "single_unitpanel/rebel_suppression",
        "single_unitpanel/rebel_suppression_icon",
        "single_unitpanel/refill_garrison_button",
        "single_unitpanel/scorch_button",
        "single_unitpanel/seizecolony_button",
        "single_unitpanel/supply_depot_button",
      ],
    },
    "hidden": {
      "note": "Hidden in every view of the coverage survey (the base game): the game decides these from its data or a click; show one by hand.",
      "hide": [
        "single_unitpanel/allow_attach_button_glow",
        "single_unitpanel/army_drill_button_glow",
        "single_unitpanel/attach_unit_window",
        "single_unitpanel/detach_unit_button",
        "single_unitpanel/enable_autotransport_button_glow",
        "single_unitpanel/enable_carpet_siege_glow",
        "single_unitpanel/enable_force_march_button_glow",
        "single_unitpanel/enable_land_explore_button",
        "single_unitpanel/enable_land_explore_button_glow",
        "single_unitpanel/enable_patrol_button_glow",
        "single_unitpanel/enable_rebel_button_glow",
        "single_unitpanel/evade_button_glow",
        "single_unitpanel/home_at_war_button_glow",
        "single_unitpanel/mission_icon",
        "single_unitpanel/mission_settings_win",
        "single_unitpanel/mothball_button_glow",
        "single_unitpanel/toggle_foreign_armies_button_glow",
      ],
    },
  },
}
