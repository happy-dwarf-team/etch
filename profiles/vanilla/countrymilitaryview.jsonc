// The countrymilitaryview window of the base game, the country view's military tab
// (docs/window-profiles.md). From the coverage survey (etch#254): with Cradle of Civilization the
// game moves most of the tab down by the height of army_professionalism, as the .gui's own comment
// on that window says and eu4.exe's UpdateArmyProfessionalism does (Steam 1.37.5: the DLC's flag at
// 0x233FF24); the survey's captures show the tab and its widgets 16 px lower, with the background,
// the close button and the title where the .gui puts them. Without the DLC the same function hides
// the professionalism bar, its background and the slacken button. Anbennar and Bigger UI keep the
// 16 px height, so this layer serves them too.
{
  "formatVersion": 1,
  "window": "countrymilitaryview",
  "checkedWith": "1.37.5",
  "selectors": {
    "cradle": {
      "kind": "data",
      "label": "Cradle of Civilization",
      "fact": "game.cradleOfCivilization",
      "values": { "yes": "Cradle of Civilization", "no": "Without it" },
      "default": "yes",
      "note": "The army professionalism bar takes its place above the tab only with the DLC; a save's dlc_enabled says whether it was active.",
    },
    "unitSelect": {
      "kind": "ui",
      "label": "Unit type choice",
      "values": { "closed": "Closed", "open": "Open" },
      "default": "closed",
      "note": "infantry_type_button, cavalry_type_button and artillery_type_button open domesticpanel_unit_select over the leaders' buttons.",
    },
  },
  "rules": {
    "cradle-moves-the-tab": {
      "note": "army_professionalism is 16 px high: the tab moves down by it, and CoCbackground, the close button and the title stay (UpdateArmyProfessionalism, Steam 0xFBC0A0). Everything else moves with the tab, activate_all, slacken_button and button_makeheirgeneral included (the survey's captures: 667 and 986 at 1080).",
      "when": { "cradle": "yes" },
      "offset": {
        "countrymilitaryview": { "y": 16 },
        "countrymilitaryview/CoCbackground": { "y": -16 },
        "countrymilitaryview/close_button": { "y": -16 },
        "countrymilitaryview/window_title": { "y": -16 },
      },
    },
    "with-cradle": {
      "note": "UpdateArmyProfessionalism hides the plain background and shows CoCbackground and army_professionalism with the DLC.",
      "when": { "cradle": "yes" },
      "hide": ["countrymilitaryview/background"],
    },
    "without-cradle": {
      "note": "UpdateArmyProfessionalism, without the DLC: hides army_professionalism, CoCbackground and slacken_button (lowering recruitment standards comes with professionalism), and shows the plain background.",
      "when": { "cradle": "no" },
      "hide": [
        "countrymilitaryview/army_professionalism",
        "countrymilitaryview/CoCbackground",
        "countrymilitaryview/slacken_button",
      ],
    },
    "unit-select-open": {
      "note": "With the unit type choice open the game hides the buttons that recruit leaders and make the ruler or the heir a general (the coverage survey, Russia 1719, 1920×1080).",
      "when": { "unitSelect": "open" },
      "hide": [
        "countrymilitaryview/button_recruit_general",
        "countrymilitaryview/button_recruit_conquistador",
        "countrymilitaryview/button_recruit_admiral",
        "countrymilitaryview/button_recruit_explorer",
        "countrymilitaryview/button_makerulergeneral",
        "countrymilitaryview/button_makeheirgeneral",
      ],
    },
    "hidden": {
      "note": "Hidden in every survey view of the tab: the game's code decides these from its data or a click; show one by hand.",
      "hide": ["countrymilitaryview/button_makeconsortgeneral"],
    },
  },
}
