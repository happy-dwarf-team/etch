// The countryreligionview window of the base game (docs/window-profiles.md). Its rule hides what the coverage
// survey's 4 captures of it show hidden; drafted from them, as the corpus's are (ADR 0006).
{
  "formatVersion": 1,
  "window": "countryreligionview",
  "checkedWith": "1.37.5",
  "selectors": {
    "religionPanel": {
      "kind": "ui",
      "label": "Religion",
      "values": {
        "orthodox": "Orthodox",
        "anglican": "Anglican",
        "buddhist": "Buddhist",
        "catholic": "Catholic",
        "confucianism": "Confucianism",
        "coptic": "Coptic",
        "fervor": "Fervor",
        "jewish": "Jewish",
        "muslim": "Muslim",
        "protestant": "Protestant",
        "shinto": "Shinto",
        "none": "No panel",
      },
      "note": "The panel of the country's religion. The second coverage run shows catholic_specific_window for France; the first, Russia, showed orthodox_specific_window (etch#258).",
    },
    "selection": {
      "kind": "ui",
      "label": "Selection screen",
      "values": { "closed": "Closed", "open": "Open" },
      "default": "closed",
      "note": "A choice opened by a click over the lower half of the view: the Orthodox icon's (pick_icon_button opens icon_selection_screen), an aspect's, a cult's, a deity's or a scholar's. The game hides the province list and the missionaries' controls under it (the coverage survey, Russia 1719 and Verne 1444).",
    },
  },
  "groups": {
    "religionPanel": {
      "label": "Religion",
      "selector": "religionPanel",
      "none": true,
      "members": {
        "orthodox": "countryreligionview/orthodox_specific_window",
        "anglican": "countryreligionview/anglican_specific_window",
        "buddhist": "countryreligionview/buddhist_specific_window",
        "catholic": "countryreligionview/catholic_specific_window",
        "confucianism": "countryreligionview/confucianism_specific_window",
        "coptic": "countryreligionview/coptic_specific_window",
        "fervor": "countryreligionview/fervor_specific_window",
        "jewish": "countryreligionview/jewish_specific_window",
        "muslim": "countryreligionview/muslim_specific_window",
        "protestant": "countryreligionview/protestant_specific_window",
        "shinto": "countryreligionview/shinto_specific_window",
      },
    },
  },
  "repeaters": {
    "countryreligionview/catholic_specific_window/active_cardinals": {
      "note": "The cardinals, up to seven (the second coverage run, France, 1550).",
      "template": "countryreligionview_cardinalitem",
      "count": 7,
    },
  },
  "rules": {
    "standard-background": {
      "note": "The game draws religionpanel_bg_top with its standard sprite (576 × 590) at every screen height, not the _large or _huge variant the window's size steps would pick (the coverage survey, every playset, 1920×1080 and 1280×720: 569 × 590, cut at the window's left edge).",
      "sprite": { "countryreligionview/religionpanel_bg_top": "GFX_country_religion_view_bg" },
    },
    "religion-icon": {
      "note": "The game's code puts the icon 62 px right of its .gui place (the coverage survey, every playset, 1920×1080 and 1280×720; etch#253).",
      "offset": { "countryreligionview/current_religion_icon": { "x": 62 } },
    },
    "hidden": {
      "note": "Hidden in every view of the coverage survey (the base game): the game decides these from its data or a click; show one by hand.",
      "hide": [
        "countryreligionview/aspect_selection_screen",
        "countryreligionview/become_Defender_of_the_Faith",
        "countryreligionview/convert_secondary_button",
        "countryreligionview/countryreligionview_convert",
        "countryreligionview/cult_selection_screen",
        "countryreligionview/defender_of_the_faith_button",
        "countryreligionview/defender_of_the_faith_emperor_button",
        "countryreligionview/defender_of_the_faith_shield",
        "countryreligionview/deity_selection_screen",
        "countryreligionview/fetishist_cult",
        "countryreligionview/full_unity",
        "countryreligionview/full_unity_bg",
        "countryreligionview/icon_selection_screen",
        "countryreligionview/invite_scholar_selection_screen",
        "countryreligionview/orthodox_specific_window/no_current_icon",
        "countryreligionview/personal_deity",
        "countryreligionview/religious_school_window",
        "countryreligionview/secondary_religion_banner",
        "countryreligionview/secondary_religion_icon",
        "countryreligionview/secondary_religion_name",
        "countryreligionview/sikh_guru_window",
        "countryreligionview/totemism_ancestor_window",
      ],
    },
    "icon-selection": {
      "when": { "selection": "open", "religionPanel": "orthodox" },
      "note": "The icon choice takes the Orthodox panel's place: the game hides the panel while it is open (the coverage survey, Russia 1719, vanilla and Bigger UI).",
      "show": ["countryreligionview/icon_selection_screen"],
      "hide": ["countryreligionview/orthodox_specific_window"],
    },
    "selection-covers-the-list": {
      "when": { "selection": "open" },
      "hide": [
        "countryreligionview/province_listbox",
        "countryreligionview/sort_name",
        "countryreligionview/sort_religion",
        "countryreligionview/sort_unity",
        "countryreligionview/sort_time",
        "countryreligionview/sort_mission",
        "countryreligionview/religionpanel_bg_bottom",
        "countryreligionview/show_subjects",
        "countryreligionview/show_subjects_title",
        "countryreligionview/assign_automatic_missionary",
        "countryreligionview/automatic_missionariy_BG",
        "countryreligionview/automatic_missionary_title",
        "countryreligionview/missionary_icon_list",
      ],
    },
  },
}
