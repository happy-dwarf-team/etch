// The countryestatesview window of the base game (spec v2 section 11, docs/window-profiles.md).
// Its rules hide what the precision corpus captures show hidden; they were drafted from the
// captures and are checked by them (ADR 0006).
{
  "formatVersion": 1,
  "window": "countryestatesview",
  "checkedWith": "1.37.5",
  "selectors": {
    "crownLand": {
      "kind": "ui",
      "label": "Crown land effect",
      "values": { "shown": "Shown", "none": "None" },
      "note": "Russia's crown land in 1719 has its modifiers, Muscovy's in 1466 says 'No Effect' (the coverage survey's run of 6 November 2026).",
    },
    "agenda": {
      "kind": "ui",
      "label": "Agenda",
      "values": { "none": "None", "shown": "Shown" },
      "note": "No agenda in Russia's game in 1719, one in Muscovy's in 1466 (the coverage survey's run of 6 November 2026).",
    },
  },
  "rules": {
    "dev-share-chart": {
      "note": "eu4.exe sizes the development pie chart 32 × 32 (Steam 1.37.5 0xF28230) where GFX_ledger_piechart_default says 128; the chart keeps its centre, the widget's lower left corner, so the widget is 96 px lower (the coverage survey: 47, 291, 32 × 32 at 1920×1080).",
      "chartSize": { "countryestatesview/dev_share_pie_chart": { "x": 32, "y": 32 } },
      "offset": { "countryestatesview/dev_share_pie_chart": { "y": 96 } },
    },
    "crown-land-icons": {
      "note": "eu4.exe gives each crown land modifier icon GFX_idea_unknown (64 × 64, at the .gui's scale 0.5 drawn 32 × 32) in place of the .gui's GFX_event_bg_transparency: the coverage survey's captures of 24 November 2026 show it on all four icons for Russia, the emperor and the Pope's controller.",
      "sprite": {
        "countryestatesview/crown_land_modifier_icon_1": "GFX_idea_unknown",
        "countryestatesview/crown_land_modifier_icon_2": "GFX_idea_unknown",
        "countryestatesview/crown_land_modifier_icon_3": "GFX_idea_unknown",
        "countryestatesview/crown_land_modifier_icon_4": "GFX_idea_unknown",
      },
    },
    "no-crown-land-effect": {
      "when": { "crownLand": "none" },
      "hide": [
        "countryestatesview/crown_land_modifier_desc_2",
        "countryestatesview/crown_land_modifier_desc_3",
        "countryestatesview/crown_land_modifier_desc_4",
        "countryestatesview/crown_land_modifier_icon_1",
        "countryestatesview/crown_land_modifier_icon_2",
        "countryestatesview/crown_land_modifier_icon_3",
        "countryestatesview/crown_land_modifier_icon_4",
      ],
    },
    "no-agenda": {
      "note": "Without an agenda the game's code writes an empty text in agenda_effects, one line high, where the .gui says AGENDA_EFFECTS (Anbennar's 106 px wraps it in three; the coverage survey of 24 November 2026).",
      "when": { "agenda": "none" },
      "hide": ["countryestatesview/agenda_icon", "countryestatesview/agenda_state"],
      "text": { "countryestatesview/agenda_effects": { "literal": "" } },
    },
  },
}
