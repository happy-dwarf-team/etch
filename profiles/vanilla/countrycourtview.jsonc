// The countrycourtview window of the base game (spec v2 section 11, docs/window-profiles.md).
// Its rules hide what the precision corpus captures show hidden; they were drafted from the
// captures and are checked by them (ADR 0006).
{
  "formatVersion": 1,
  "window": "countrycourtview",
  "checkedWith": "1.37.5",
  "selectors": {
    "consort": {
      "kind": "ui",
      "label": "Consort",
      "values": { "none": "None", "shown": "Shown" },
      "note": "Russia's court in 1719 has no consort, Muscovy's in 1466 has one (the coverage survey's run of 6 November 2026).",
    },
    "heirClaim": {
      "kind": "ui",
      "label": "Heir's claim",
      "values": { "none": "None", "shown": "Shown" },
      "note": "Hidden in Russia's court in 1719, shown in Muscovy's in 1466 (the coverage survey's run of 6 November 2026).",
    },
  },
  "rules": {
    "no-consort": {
      "when": { "consort": "none" },
      "hide": [
        "countrycourtview/monarch_queen_adm_icon",
        "countrycourtview/monarch_queen_adm_value",
        "countrycourtview/monarch_queen_age",
        "countrycourtview/monarch_queen_crown_icon",
        "countrycourtview/monarch_queen_dip_icon",
        "countrycourtview/monarch_queen_dip_value",
        "countrycourtview/monarch_queen_mil_icon",
        "countrycourtview/monarch_queen_mil_value",
        "countrycourtview/queen_gender",
      ],
    },
    "no-heir-claim": {
      "when": { "heirClaim": "none" },
      "hide": ["countrycourtview/monarch_heir_claim"],
    },
    "hidden": {
      "note": "Hidden in the corpus capture of \"court\" in vanilla (Russia, 17 March 1719): the game decides these from its data or a click; show one by hand.",
      "hide": [
        "countrycourtview/assign_heir_button",
        "countrycourtview/court_select",
        "countrycourtview/election_info",
        "countrycourtview/monarch_heir_crown_icon",
        "countrycourtview/support_heir_button",
      ],
    },
  },
}
