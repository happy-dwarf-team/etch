// The countryeconomyview window of the base game, the country view's economy tab
// (docs/window-profiles.md). Its totals and values are texts the game's code writes over the
// .gui's own ("TOTAL +1234", "War Exhaustion: 12%", "Tax Base: 124"), which wrap in their boxes
// where the game's numbers fit on one line (the coverage survey, Anbennar's Verne 1444: 9.21,
// 0.0/20, 105).
{
  "formatVersion": 1,
  "window": "countryeconomyview",
  "checkedWith": "1.37.5",
  "selectors": {
    "loanList": {
      "kind": "ui",
      "label": "Loans to repay",
      "values": { "closed": "Closed", "open": "Open" },
      "default": "closed",
      "note": "repay_loan opens countryeconomyview_repayloan, the list of loans; closed as the tab opens (the coverage survey, Russia 1719 and Verne 1444).",
    },
  },
  "rules": {
    "loan-list-closed": {
      "when": { "loanList": "closed" },
      "hide": ["countryeconomyview/countryeconomyview_repayloan"],
    },
  },
  "content": {
    "countryeconomyview/incomes_total": { "engine": true, "generated": "number" },
    "countryeconomyview/expenses_total": { "engine": true, "generated": "number" },
    "countryeconomyview/balance": { "engine": true, "generated": "number" },
    "countryeconomyview/inflation_info": { "engine": true, "generated": "percent" },
    "countryeconomyview/war_exhaustion": { "engine": true, "generated": "number" },
    "countryeconomyview/development_base": { "engine": true, "generated": "number" },
    "countryeconomyview/take_loan_sum": { "engine": true, "generated": "number" },
  },
}
