// The topbar window of the base game (spec v2 section 11, docs/window-profiles.md).
// Its rules hide what the precision corpus captures show hidden; they were drafted from the
// captures and are checked by them (ADR 0006).
{
  "formatVersion": 1,
  "window": "topbar",
  "checkedWith": "1.37.5",
  "selectors": {
    "legitimacy": {
      "kind": "ui",
      "label": "Legitimacy",
      "values": {
        "meritocracy": "Meritocracy",
        "legitimacy": "Legitimacy",
        "republic": "Republican tradition",
        "devotion": "Devotion",
        "unity": "Horde unity",
      },
      "note": "The top bar shows one of these by the country's government: meritocracy for Russia in 1719, legitimacy for France in 1550 (the coverage survey, etch#258).",
    },
  },
  "rules": {
    "hidden": {
      "note": "Hidden in the corpus capture of \"court\" and \"diplomacy-dialog\" and \"diplomacy\" and \"estates\" and \"hud\" and \"province\" in vanilla (Russia, 17 March 1719): the game decides these from its data or a click; show one by hand.",
      "hide": [
        "topbar/icon_dev",
        "topbar/icon_leg",
        "topbar/icon_rep",
        "topbar/icon_unity",
        "topbar/liberty_desire_topbar",
        "topbar/text_dev",
        "topbar/text_leg",
        "topbar/text_rep",
        "topbar/text_unity",
      ],
    },
    "unused-icons": {
      "note": "topbar_1 to topbar_3 have the sprite GFX_remove and sit at x = 99512, and the game never shows them (the coverage survey, vanilla and Anbennar, every top bar view).",
      "hide": ["topbar/topbar_1", "topbar/topbar_2", "topbar/topbar_3"],
    },
    "legitimacy": {
      "when": { "legitimacy": "legitimacy" },
      "show": ["topbar/icon_leg", "topbar/text_leg"],
      "hide": ["topbar/icon_meritocracy", "topbar/text_meritocracy"],
    },
    "republic": {
      "when": { "legitimacy": "republic" },
      "show": ["topbar/icon_rep", "topbar/text_rep"],
      "hide": [
        "topbar/icon_leg",
        "topbar/text_leg",
        "topbar/icon_meritocracy",
        "topbar/text_meritocracy",
      ],
    },
    "devotion": {
      "when": { "legitimacy": "devotion" },
      "show": ["topbar/icon_dev", "topbar/text_dev"],
      "hide": [
        "topbar/icon_leg",
        "topbar/text_leg",
        "topbar/icon_meritocracy",
        "topbar/text_meritocracy",
      ],
    },
    "unity": {
      "when": { "legitimacy": "unity" },
      "show": ["topbar/icon_unity", "topbar/text_unity"],
      "hide": [
        "topbar/icon_leg",
        "topbar/text_leg",
        "topbar/icon_meritocracy",
        "topbar/text_meritocracy",
      ],
    },
  },
  "content": {
    "topbar/text_gold": {
      "save": "countries.{country}.treasury",
      "format": "treasury",
      "note": "The top bar's refresh (eu4.exe 0x1435530) writes the treasury in whole ducats, in thousands with k from 10000 (0x14341E0): the coverage survey's 1000000 ducats show 1000k.",
    },
    "topbar/text_manpower": {
      "save": "countries.{country}.manpower",
      "format": "men",
      "note": "The manpower in men (CRegiment::GetVisualStrength, 0xAE8C10): 45,500, and in thousands with k above 99999 (the survey's 2534.947 shows 2534k).",
    },
    "topbar/text_stability": {
      "save": "countries.{country}.stability",
      "format": "signedStability",
      "note": "White with + from zero up, red below (0x1435FD1): +3.",
    },
    "topbar/text_prestige": {
      "save": "countries.{country}.prestige",
      "format": "signed",
      "note": "White with + above zero, red below, yellow 0 (0x1436375): +100.",
    },
    "topbar/powerprojection_topbar/text_powerprojection": {
      "save": "countries.{country}.current_power_projection",
      "format": "signed",
      "note": "As the prestige (0x1434650), of the power projection the save keeps: +100.",
    },
  },
}
