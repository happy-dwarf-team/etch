// The ledger window of the base game (spec v2 section 11, docs/window-profiles.md).
// Its rules hide what the precision corpus captures show hidden; they were drafted from the
// captures and are checked by them (ADR 0006).
{
  "formatVersion": 1,
  "window": "ledger",
  "checkedWith": "1.37.5",
  "selectors": {
    "page": {
      "kind": "ui",
      "label": "Page",
      "values": { "index": "Index", "table": "A table" },
      "note": "The index, or one of the pages with a table of countries. The game's code puts the columns and their sort buttons by the page; the graphs' pages are not modelled.",
    },
  },
  "rules": {
    "page-index": {
      "when": { "page": "index" },
      "hide": ["ledger/default_listbox", "ledger/ledger_sort_buttons"],
    },
    "page-table": {
      "when": { "page": "table" },
      "note": "Hidden on a table page in the coverage survey.",
      "hide": [
        "ledger/ledger_great_projects_bg",
        "ledger/ledger_index",
        "ledger/ledger_linegraph_bg",
      ],
    },
    "hidden": {
      "note": "Hidden in the corpus capture of \"ledger\" in vanilla (Russia, 17 March 1719): the game decides these from its data or a click; show one by hand.",
      "hide": [
        "ledger/filter_edit_box_bg",
        "ledger/filter_edit_box_icon",
        "ledger/filter_list",
        "ledger/ledger_linegraph_legend",
        "ledger/ledger_linegraphs",
        "ledger/ledger_piecharts",
        "ledger/ledger_text_filter",
      ],
    },
  },
  "repeaters": {
    "ledger/ledger_sort_buttons": {
      "note": "One sort button and heading per column of the page, as CLedger::UpdateSpreadSheet (eu4.exe 0x118CFF0) puts them: the great powers page's columns (CLedger::CLedger, 0x117BE40), with the weights 1, 3, 1, 1, 1, 1 and numbers in the last three. Other table pages have other columns; the coverage survey's ledger view is this one (vanilla, Bigger UI, Proper 2K UI Enhanced and Anbennar).",
      "template": "ledger_default_button",
      "count": 6,
      "place": {
        "table": {
          "weights": [1, 3, 1, 1, 1, 1],
          "numbers": [4, 5, 6],
          "label": "ledger_default_button_text",
          "list": "default_listbox",
        },
      },
    },
    "ledger/default_listbox": {
      "note": "One row per country of the page: 9 fit at 1920×1080 in the coverage survey. The game's code adds a text box to a row for each column of the page.",
      "template": "default_listbox_entry",
      "count": 9,
    },
  },
}
