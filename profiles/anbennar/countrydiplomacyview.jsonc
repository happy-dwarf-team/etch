// The countrydiplomacyview window in the Anbennar playset (Anbennar, Proper 2K UI Enhanced, P2KE Patch -
// Anbennar), over the vanilla profile: rules replaced or removed (null) where the playset
// differs. Drafted from the playset's corpus captures (ADR 0006); Anbennar's descriptor gives
// version "1" for every release, so checkedWith says little.
{
  "formatVersion": 1,
  "window": "countrydiplomacyview",
  "checkedWith": "1",
  "mod": {
    "remoteFileId": "1385440355",
    "name": "Anbennar: A Fantasy Total Conversion",
  },
  "selectors": {
    "rulerMage": {
      "kind": "ui",
      "label": "Ruler is a mage",
      "values": { "yes": "Mage", "no": "Not a mage" },
      "default": "no",
      "note": "ruler_is_mage_icon shows by the ruler's name when the ruler is a mage (the coverage survey: the emperor of 1444).",
    },
    "shieldGlow": {
      "kind": "ui",
      "label": "Shield glow",
      "values": { "no": "None", "yes": "Glow" },
      "default": "no",
      "note": "countryshield_glow shows behind the chosen country's shield in every diplomacy view of Bluescale (1472) and in Kobildzan's own (1594), and in none of Verne's (1444); what decides it is not read in the code.",
    },
  },
  "rules": {
    "hidden": {
      "note": "Hidden in the corpus capture of \"diplomacy\" in the Anbennar playset (Verne, 11 November 1444): the game decides these from its data or a click; show one by hand.",
      "hide": [
        "countrydiplomacyview/countryshield_glow",
        "countrydiplomacyview/custom_diplomacy_window",
        "countrydiplomacyview/diplomacy_favors_progress_bar",
        "countrydiplomacyview/diplomacy_favors_progress_frame",
        "countrydiplomacyview/diplomacy_favors_progress_indicator",
        "countrydiplomacyview/diplomacy_trust_progress_bar",
        "countrydiplomacyview/diplomacy_trust_progress_frame",
        "countrydiplomacyview/diplomacy_trust_progress_indicator",
        "countrydiplomacyview/domesticpanel_bg_top",
        "countrydiplomacyview/election_info",
        "countrydiplomacyview/favors_label",
        "countrydiplomacyview/favors_value",
        "countrydiplomacyview/feedback_bg",
        "countrydiplomacyview/friendly_checkbox",
        "countrydiplomacyview/friendly_icon",
        "countrydiplomacyview/friendly_label",
        "countrydiplomacyview/hostile_checkbox",
        "countrydiplomacyview/hostile_icon",
        "countrydiplomacyview/hostile_label",
        "countrydiplomacyview/join_offensive_wars_checkbox",
        "countrydiplomacyview/label_rivals_not_possible",
        "countrydiplomacyview/lake_fed_info_cohesion_diplo",
        "countrydiplomacyview/lake_fed_info_cohesion_not_republic",
        "countrydiplomacyview/lake_fed_info_diplo",
        "countrydiplomacyview/lake_fed_info_diplo_not_republic",
        "countrydiplomacyview/manual_manage_checkbox",
        "countrydiplomacyview/manual_manage_label",
        "countrydiplomacyview/member_of_HRE",
        "countrydiplomacyview/neutral_checkbox",
        "countrydiplomacyview/neutral_icon",
        "countrydiplomacyview/neutral_label",
        "countrydiplomacyview/provincelist",
        "countrydiplomacyview/provincelist_desc",
        "countrydiplomacyview/provincelist_label",
        "countrydiplomacyview/raj_text_cohesion_diplo",
        "countrydiplomacyview/ruler_is_mage_icon",
        "countrydiplomacyview/select_rivals_window",
        "countrydiplomacyview/threat_checkbox",
        "countrydiplomacyview/threat_label",
        "countrydiplomacyview/threatened_icon",
        "countrydiplomacyview/trust_label",
        "countrydiplomacyview/trust_value",
        "countrydiplomacyview/vassal_select_window",
      ],
    },
    "ruler-mage": {
      "when": { "rulerMage": "yes" },
      "show": ["countrydiplomacyview/ruler_is_mage_icon"],
    },
    "shield-glow": {
      "when": { "shieldGlow": "yes" },
      "show": ["countrydiplomacyview/countryshield_glow"],
    },
  },
}
