// The country_selection_panel window in the Anbennar playset (Anbennar, Proper 2K UI Enhanced, P2KE Patch -
// Anbennar), over the vanilla profile: rules replaced or removed (null) where the playset
// differs. Drafted from the playset's corpus captures (ADR 0006); Anbennar's descriptor gives
// version "1" for every release, so checkedWith says little.
{
  "formatVersion": 1,
  "window": "country_selection_panel",
  "checkedWith": "1",
  "mod": {
    "remoteFileId": "1385440355",
    "name": "Anbennar: A Fantasy Total Conversion",
  },
  "rules": {
    "hidden-mainmenu-mainmenu_panel_bottom-continue_container-on-main-menu": {
      "note": "Hidden in the corpus capture of \"lobby\" and \"main-menu\" in the Anbennar playset (Verne, 11 November 1444): the game decides these from its data or a click; show one by hand.",
      "when": {
        "page": "main-menu",
      },
      "hide": [
        "country_selection_panel/mainmenu/mainmenu_panel_bottom/continue_container/ironman_icon",
      ],
    },
    "hidden-mainmenu-mainmenu_panel_bottom-on-main-menu": {
      "note": "Hidden in the corpus capture of \"lobby\" and \"main-menu\" in the Anbennar playset (Verne, 11 November 1444): the game decides these from its data or a click; show one by hand.",
      "when": {
        "page": "main-menu",
      },
      "hide": ["country_selection_panel/mainmenu/mainmenu_panel_bottom/nudge_button"],
    },
  },
}
