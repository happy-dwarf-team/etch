// The topbar window in the Anbennar playset (Anbennar, Proper 2K UI Enhanced, P2KE Patch -
// Anbennar), over the vanilla profile: rules replaced or removed (null) where the playset
// differs. Drafted from the playset's corpus captures (ADR 0006); Anbennar's descriptor gives
// version "1" for every release, so checkedWith says little.
{
  "formatVersion": 1,
  "window": "topbar",
  "checkedWith": "1",
  "mod": {
    "remoteFileId": "1385440355",
    "name": "Anbennar: A Fantasy Total Conversion",
  },
  "selectors": {
    "magicMenu": {
      "kind": "scripted",
      "label": "Magic menu",
      "values": {
        "closed": "Closed",
        "main": "Main",
        "spellbook": "Spellbook",
        "advancement": "Advancements",
      },
      "note": "Anbennar's magic menu, opened from the country view's decisions tab; a scripted interface decides what shows.",
    },
    "achievements": {
      "kind": "scripted",
      "label": "Achievements",
      "values": { "closed": "Closed", "open": "Open" },
      "note": "Anbennar's achievements window, opened from the top bar.",
    },
    "playerShieldGlow": {
      "kind": "ui",
      "label": "Player's shield glow",
      "values": { "no": "None", "yes": "Glow" },
      "default": "no",
      "note": "player_shield_glow shows behind the player's shield in every top bar of Bluescale (1472) and Kobildzan (1594), and in none of Verne's (1444); what decides it is not read in the code.",
    },
  },
  "groups": {
    "magicMenu": {
      "label": "Magic menu page",
      "selector": "magicMenu",
      "none": true,
      "members": {
        "main": "topbar/magic_menu_parent/magic_menu_main",
        "spellbook": "topbar/magic_menu_parent/magic_menu_spellbook_window",
        "advancement": "topbar/magic_menu_parent/magic_menu_advancement_window",
      },
    },
  },
  "rules": {
    "hidden": {
      "note": "Hidden in the corpus capture of \"court\" and \"diplomacy\" and \"estates\" and \"hud\" in the Anbennar playset (Verne, 11 November 1444): the game decides these from its data or a click; show one by hand.",
      "hide": [
        "topbar/achievements_alert_window",
        "topbar/icon_dev",
        "topbar/icon_meritocracy",
        "topbar/icon_rep",
        "topbar/icon_unity",
        "topbar/liberty_desire_topbar",
        "topbar/player_shield_glow",
        "topbar/racial_pop_root_window",
        "topbar/text_dev",
        "topbar/text_meritocracy",
        "topbar/text_rep",
        "topbar/text_unity",
      ],
    },
    "player-shield-glow": {
      "when": { "playerShieldGlow": "yes" },
      "show": ["topbar/player_shield_glow"],
    },
    "magic-menu-closed": {
      "when": { "magicMenu": "closed" },
      "hide": ["topbar/magic_menu_parent"],
    },
    "magic-menu-main": {
      "when": { "magicMenu": "main" },
      "note": "Hidden on this page of the magic menu in the coverage survey (Anbennar alone, 1920×1080); scripted, so it can differ by country.",
      "hide": [
        "topbar/magic_menu_parent/magic_menu_advancement_study_window",
        "topbar/magic_menu_parent/magic_menu_patron_window",
      ],
    },
    "magic-menu-spellbook": {
      "when": { "magicMenu": "spellbook" },
      "note": "Hidden on this page of the magic menu in the coverage survey (Anbennar alone, 1920×1080); scripted, so it can differ by country.",
      "hide": [
        "topbar/magic_menu_parent/magic_menu_advancement_study_window",
        "topbar/magic_menu_parent/magic_menu_patron_window",
        "topbar/magic_menu_parent/magic_menu_spellbook_window/magic_menu_custom_spell_lists_container",
        "topbar/magic_menu_parent/magic_menu_spellbook_window/magic_menu_standard_spells_window/magic_menu_spellbook_abjuration",
        "topbar/magic_menu_parent/magic_menu_spellbook_window/magic_menu_standard_spells_window/magic_menu_spellbook_conjuration",
        "topbar/magic_menu_parent/magic_menu_spellbook_window/magic_menu_standard_spells_window/magic_menu_spellbook_enchantment",
        "topbar/magic_menu_parent/magic_menu_spellbook_window/magic_menu_standard_spells_window/magic_menu_spellbook_evocation",
        "topbar/magic_menu_parent/magic_menu_spellbook_window/magic_menu_standard_spells_window/magic_menu_spellbook_illusion",
        "topbar/magic_menu_parent/magic_menu_spellbook_window/magic_menu_standard_spells_window/magic_menu_spellbook_necromancy",
        "topbar/magic_menu_parent/magic_menu_spellbook_window/magic_menu_standard_spells_window/magic_menu_spellbook_transmutation",
      ],
    },
    "magic-menu-advancement": {
      "when": { "magicMenu": "advancement" },
      "note": "Hidden on this page of the magic menu in the coverage survey (Anbennar alone, 1920×1080); scripted, so it can differ by country.",
      "hide": [
        "topbar/magic_menu_parent/magic_menu_advancement_study_window",
        "topbar/magic_menu_parent/magic_menu_advancement_window/advancement_unique_projects_window",
        "topbar/magic_menu_parent/magic_menu_patron_window",
      ],
    },
    "achievements-closed": {
      "when": { "achievements": "closed" },
      "hide": ["topbar/achievements_root_window"],
    },
