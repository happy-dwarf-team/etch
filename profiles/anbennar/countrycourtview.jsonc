// The countrycourtview window in the Anbennar playset (Anbennar, Proper 2K UI Enhanced, P2KE Patch -
// Anbennar), over the vanilla profile: rules replaced or removed (null) where the playset
// differs. Drafted from the playset's corpus captures (ADR 0006); Anbennar's descriptor gives
// version "1" for every release, so checkedWith says little.
{
  "formatVersion": 1,
  "window": "countrycourtview",
  "checkedWith": "1",
  "mod": {
    "remoteFileId": "1385440355",
    "name": "Anbennar: A Fantasy Total Conversion",
  },
  "selectors": {
    "succession": {
      "kind": "ui",
      "label": "Succession",
      "values": { "heir": "Heir", "elective": "Elective, no heir" },
      "note": "Verne's court (1444) has an heir; Kobildzan's (1594) is elective, with the election's notice and no heir (the coverage survey, etch#258).",
    },
  },
  "rules": {
    "hidden": {
      "note": "Hidden in the corpus capture of \"court\" in the Anbennar playset (Verne, 11 November 1444): the game decides these from its data or a click; show one by hand.",
      "hide": [
        "countrycourtview/abdicate_ruler_forbidden",
        "countrycourtview/assign_heir_button",
        "countrycourtview/court_select",
        "countrycourtview/election_info",
        "countrycourtview/monarch_heir_crown_icon",
        "countrycourtview/support_heir_button",
      ],
    },
    "no-consort": {
      "when": { "consort": "none" },
      "hide": [
        "countrycourtview/monarch_queen_adm_icon",
        "countrycourtview/monarch_queen_adm_value",
        "countrycourtview/monarch_queen_age",
        "countrycourtview/monarch_queen_dip_icon",
        "countrycourtview/monarch_queen_dip_value",
        "countrycourtview/monarch_queen_mil_icon",
        "countrycourtview/monarch_queen_mil_value",
        "countrycourtview/monarch_queen_name",
        "countrycourtview/monarch_queen_personality_list",
        "countrycourtview/queen_banner_green",
        "countrycourtview/queen_gender",
      ],
    },
    "elective": {
      "when": { "succession": "elective" },
      "show": ["countrycourtview/election_info"],
      "hide": [
        "countrycourtview/abdicate_ruler_button",
        "countrycourtview/disinherit_button",
        "countrycourtview/extend_regency_button",
        "countrycourtview/heir_banner_green",
        "countrycourtview/heir_gender",
        "countrycourtview/monarch_heir_adm_icon",
        "countrycourtview/monarch_heir_adm_value",
        "countrycourtview/monarch_heir_age",
        "countrycourtview/monarch_heir_dip_icon",
        "countrycourtview/monarch_heir_dip_value",
        "countrycourtview/monarch_heir_mil_icon",
        "countrycourtview/monarch_heir_mil_value",
        "countrycourtview/monarch_heir_name",
        "countrycourtview/monarch_heir_personality_list",
      ],
    },
  },
}
