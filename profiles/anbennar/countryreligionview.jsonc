// The countryreligionview window of Anbennar alone (docs/window-profiles.md). Its rule hides what the coverage
// survey's 4 captures of it show hidden; drafted from them, as the corpus's are (ADR 0006). The base game's
// religion panels, the personal deity, the province list and full unity follow selectors, fitted on Kobildzan
// (1594) and checked on Bluescale (1472), which no rule was drafted from.
{
  "formatVersion": 1,
  "window": "countryreligionview",
  "checkedWith": "1",
  "mod": {
    "remoteFileId": "1385440355",
    "name": "Anbennar: A Fantasy Total Conversion",
  },
  "selectors": {
    "religionPanel": {
      "kind": "ui",
      "label": "Religion",
      "values": {
        "none": "No panel",
        "orthodox": "Orthodox",
        "anglican": "Anglican",
        "buddhist": "Buddhist",
        "catholic": "Catholic",
        "confucianism": "Confucianism",
        "coptic": "Coptic",
        "fervor": "Fervor",
        "jewish": "Jewish",
        "muslim": "Muslim",
        "protestant": "Protestant",
        "shinto": "Shinto",
      },
      "note": "The base game's panel an Anbennar religion takes, none for most: Verne (1444) shows none, Kobildzan (1594) the jewish one, for its aspects (the coverage survey, etch#258).",
    },
    "deity": {
      "kind": "ui",
      "label": "Personal deity",
      "values": { "shown": "Shown", "none": "None" },
      "note": "The religion has a personal deity: Verne's (1444) does, Kobildzan's (1594) does not.",
    },
    "provinceList": {
      "kind": "ui",
      "label": "Province list",
      "values": { "none": "None", "shown": "Shown" },
      "note": "The list of provinces by religion with its sort buttons: hidden in Verne's view (1444), shown in Kobildzan's (1594).",
    },
    "deitySelection": {
      "kind": "ui",
      "label": "Deity selection",
      "values": { "closed": "Closed", "open": "Open" },
      "note": "The deity selection screen, opened by a click (the coverage survey's view anbennar-alone-save-s48).",
    },
    "fullUnity": {
      "kind": "ui",
      "label": "Full unity",
      "values": { "no": "Below full", "full": "Full" },
      "note": "The religious unity is full: shown in one of Verne's views (1444), not in Kobildzan's (1594).",
    },
  },
  "rules": {
    "hidden": {
      "note": "Hidden in every view of the coverage survey (Anbennar alone): the game decides these from its data or a click; show one by hand.",
      "hide": [
        "countryreligionview/accretive_path_admin_blocker",
        "countryreligionview/accretive_path_diplo_blocker",
        "countryreligionview/accretive_path_mil_blocker",
        "countryreligionview/aspect_selection_screen",
        "countryreligionview/beast_memory_admin_blocker",
        "countryreligionview/beast_memory_diplo_blocker",
        "countryreligionview/beast_memory_mil_blocker",
        "countryreligionview/become_Defender_of_the_Faith",
        "countryreligionview/convert_secondary_button",
        "countryreligionview/countryreligionview_convert",
        "countryreligionview/cult_selection_screen",
        "countryreligionview/defender_of_the_faith_button",
        "countryreligionview/defender_of_the_faith_emperor_shield",
        "countryreligionview/defender_of_the_faith_shield",
        "countryreligionview/deity_selection_screen",
        "countryreligionview/devouring_path_blocker",
        "countryreligionview/fetishist_cult",
        "countryreligionview/full_unity",
        "countryreligionview/full_unity_bg",
        "countryreligionview/high_philosophy_visvatma",
        "countryreligionview/icon_selection_screen",
        "countryreligionview/invite_scholar_selection_screen",
        "countryreligionview/kheionist_deity_desc",
        "countryreligionview/noukahi_pantheon_pilgrimage_window/noukahi_pantheon_pilgrimage_background",
        "countryreligionview/noukahi_pantheon_pilgrimage_window/noukahi_pantheon_pilgrimage_furled",
        "countryreligionview/noukahi_pantheon_pilgrimage_window/noukahi_pantheon_pilgrimage_khet",
        "countryreligionview/noukahi_pantheon_pilgrimage_window/noukahi_pantheon_pilgrimage_khet_button_close",
        "countryreligionview/noukahi_pantheon_pilgrimage_window/noukahi_pantheon_pilgrimage_khet_button_open",
        "countryreligionview/noukahi_pantheon_pilgrimage_window/noukahi_pantheon_pilgrimage_main_button_close",
        "countryreligionview/noukahi_pantheon_pilgrimage_window/noukahi_pantheon_pilgrimage_main_button_open",
        "countryreligionview/noukahi_pantheon_pilgrimage_window/noukahi_pantheon_pilgrimage_unique",
        "countryreligionview/noukahi_pantheon_pilgrimage_window/noukahi_pantheon_pilgrimage_unique_button_close",
        "countryreligionview/noukahi_pantheon_pilgrimage_window/noukahi_pantheon_pilgrimage_unique_button_open",
        "countryreligionview/noukahi_pantheon_pilgrimage_window/noukahi_pantheon_pilgrimage_window_khet",
        "countryreligionview/noukahi_pantheon_pilgrimage_window/noukahi_pantheon_pilgrimage_window_main",
        "countryreligionview/noukahi_pantheon_pilgrimage_window/noukahi_pantheon_pilgrimage_window_unique",
        "countryreligionview/personal_deity",
        "countryreligionview/personal_deity/deity_icon",
        "countryreligionview/province_listbox",
        "countryreligionview/religious_school_window",
        "countryreligionview/runefather_bar_window",
        "countryreligionview/secondary_religion_banner",
        "countryreligionview/secondary_religion_icon",
        "countryreligionview/secondary_religion_name",
        "countryreligionview/shadow_pact_reroll_portent",
        "countryreligionview/sikh_guru_window",
        "countryreligionview/sort_mission",
        "countryreligionview/sort_name",
        "countryreligionview/sort_religion",
        "countryreligionview/sort_time",
        "countryreligionview/sort_unity",
        "countryreligionview/speaking_memory_memory_window",
        "countryreligionview/suhans_praxis_visvatma",
        "countryreligionview/swap_cult_button",
        "countryreligionview/swap_deity_button",
        "countryreligionview/taychend_deity_desc",
        "countryreligionview/taychendi_window",
        "countryreligionview/taychendi_window_button",
        "countryreligionview/totemism_ancestor_window",
        "countryreligionview/xhazobkult_light_the_pyres",
        "countryreligionview/yudunyovi_quests_button",
      ],
    },
    "deity": {
      "when": { "deity": "shown" },
      "show": ["countryreligionview/personal_deity"],
    },
    "province-list": {
      "when": { "provinceList": "shown" },
      "show": [
        "countryreligionview/province_listbox",
        "countryreligionview/sort_mission",
        "countryreligionview/sort_name",
        "countryreligionview/sort_religion",
        "countryreligionview/sort_time",
        "countryreligionview/sort_unity",
      ],
    },
    "deity-selection": {
      "note": "The screen covers the lower half of the view, and the game hides the missionaries' controls under it, as under the base game's selection screens.",
      "when": { "deitySelection": "open" },
      "show": ["countryreligionview/deity_selection_screen"],
      "hide": [
        "countryreligionview/religionpanel_bg_bottom",
        "countryreligionview/show_subjects",
        "countryreligionview/show_subjects_title",
        "countryreligionview/assign_automatic_missionary",
        "countryreligionview/automatic_missionariy_BG",
        "countryreligionview/automatic_missionary_title",
        "countryreligionview/missionary_icon_list",
      ],
    },
    "full-unity": {
      "when": { "fullUnity": "full" },
      "show": ["countryreligionview/full_unity", "countryreligionview/full_unity_bg"],
    },
  },
}
