// The province view in the Anbennar playset (Anbennar, Proper 2K UI Enhanced, P2KE Patch -
// Anbennar), over the vanilla profile (spec v2 section 11). Anbennar adds its views through
// scripted GUI: the province button bar and the aPUI windows, whose potential triggers Etch shows
// and never evaluates; they are set by hand (etch#155, ADR 0006). Anbennar's descriptor gives
// version "1" for every release, so checkedWith says little.
{
  "formatVersion": 1,
  "window": "provinceview",
  "checkedWith": "1",
  "mod": {
    "remoteFileId": "1385440355",
    "name": "Anbennar: A Fantasy Total Conversion",
  },
  "selectors": {
    "buttonBar": {
      "kind": "scripted",
      "label": "Province button bar",
      "values": { "closed": "Closed", "open": "Open" },
      "note": "custom_gui/provinceview.txt: the owner is FROM or its subject, and FROM has the country flag province_button_UI_opened (set by province_button_button).",
    },
    "apui": {
      "kind": "scripted",
      "label": "aPUI window",
      "values": {
        "none": "None",
        "transmutative_path": "Transmutative path",
        "gor_vazumbrog_vault": "Gor Vazumbrog vault",
        "zena_medakas_majestic_menagerie": "Zena Medaka's menagerie",
        "mangrove_bio_infra": "Mangrove bio-infrastructure",
        "kobold_citadel": "Kobold citadel",
        "gene_pillar_interaction": "Gene pillars",
      },
      "note": "has_open_aPUI_in_province = { name = <window> }: FROM has the flag aPUI_<window>_flag, owns the province and it is eligible. Opening one clears the others' flags.",
    },
    "digging": {
      "kind": "scripted",
      "label": "Digging operations",
      "values": {
        "closed": "Closed",
        "dig": "Dig deeper",
        "repair": "Repair hold",
        "digging": "Digging",
      },
      "note": "custom_gui/provinceview.txt 2-490: the province flag diggy_diggy_estimate_flag, which dig_deeper_capital in the button bar sets and clears, and the owner is FROM. diggy_diggy_go without a ruined hold, diggy_diggy_repair with one; the bar while digging_deeper or restoring_hold is built, a fill per 20 % of progress (this view shows 60 %).",
    },
    "centaurCapital": {
      "kind": "scripted",
      "label": "Nomad capital",
      "values": { "no": "No", "yes": "Centaur nomads" },
      "note": "custom_gui/provinceview.txt 2101, 2171: IW_move_capital_button and its blocker cover move_capital when the province is FROM's and FROM has the government attribute centaur_nomadism_attribute.",
    },
    "parliamentForbidden": {
      "kind": "scripted",
      "label": "Adding seats",
      "values": { "allowed": "Allowed", "forbidden": "Forbidden" },
      "note": "custom_gui/provinceview.txt 491: add_parliament_forbidden covers add_parliament in FROM's province without a seat when FROM has the country flag cant_manually_add_parliament_seats.",
    },
    "slot1": {
      "kind": "scripted",
      "label": "Button bar, slot 1",
      "values": {
        "none": "Dummy",
        "sedentarization_make_outpost": "sedentarization_make_outpost",
        "merfolk_settlement_button": "merfolk_settlement_button",
        "aPUI_gene_pillar_interaction_button": "aPUI_gene_pillar_interaction_button",
      },
      "note": "The buttons of the bar's first slot share its place over GFX_province_button_dummy_1; each shows by its own potential in custom_gui/provinceview.txt.",
    },
    "slot2": {
      "kind": "scripted",
      "label": "Button bar, slot 2",
      "values": {
        "none": "Dummy",
        "dig_deeper_capital": "dig_deeper_capital",
        "ebonsteel_expand_infra_button": "ebonsteel_expand_infra_button",
        "mangrove_bio_infra_button": "mangrove_bio_infra_button",
        "open_menu_kobold_citadel": "open_menu_kobold_citadel",
      },
      "note": "The buttons of the bar's second slot share its place over GFX_province_button_dummy_2; each shows by its own potential in custom_gui/provinceview.txt.",
    },
    "slot3": {
      "kind": "scripted",
      "label": "Button bar, slot 3",
      "values": {
        "none": "Dummy",
        "transmutative_path_infuse_chi_button": "transmutative_path_infuse_chi_button",
        "utubodi_unification_own_button": "utubodi_unification_own_button",
        "utubodi_unification_vassal_button": "utubodi_unification_vassal_button",
      },
      "note": "The buttons of the bar's third slot share its place over GFX_province_button_dummy_3; each shows by its own potential in custom_gui/provinceview.txt.",
    },
    "slot4": {
      "kind": "scripted",
      "label": "Button bar, slot 4",
      "values": {
        "none": "Dummy",
        "harpy_roost_button": "harpy_roost_button",
        "deepwoods_rangers_button": "deepwoods_rangers_button",
        "lencori_behemoth_shipyard_button": "lencori_behemoth_shipyard_button",
        "charkuchin_kobold_supply_facility_button": "charkuchin_kobold_supply_facility_button",
      },
      "note": "The buttons of the bar's fourth slot share its place over GFX_province_button_dummy_4; each shows by its own potential in custom_gui/provinceview.txt.",
    },
    "slot5": {
      "kind": "scripted",
      "label": "Button bar, slot 5",
      "values": {
        "none": "Dummy",
        "aPUI_zena_medakas_majestic_menagerie_button": "aPUI_zena_medakas_majestic_menagerie_button",
        "khatalashya_province_button": "khatalashya_province_button",
        "aPUI_gor_vazumbrog_vault_button": "aPUI_gor_vazumbrog_vault_button",
        "gor_vazumbrog_province_action_road": "gor_vazumbrog_province_action_road",
        "gor_vazumbrog_province_action_cavern": "gor_vazumbrog_province_action_cavern",
        "arawkelin_deforestation_button": "arawkelin_deforestation_button",
        "A49_create_wyvern_farm_button": "A49_create_wyvern_farm_button",
        "chaqway_markets_button": "chaqway_markets_button",
        "verne_port_of_adventure_button": "verne_port_of_adventure_button",
        "S15_aquaculture_button": "S15_aquaculture_button",
        "celmaldor_trade_league_investment": "celmaldor_trade_league_investment",
        "I57_challenge_to_negeal_button": "I57_challenge_to_negeal_button",
        "jungle_fortress_button": "jungle_fortress_button",
        "spiked_log_install_spiky_traps_button": "spiked_log_install_spiky_traps_button",
        "R36_traveling_society_button": "R36_traveling_society_button",
        "S90_spire_explode_button": "S90_spire_explode_button",
        "R54_build_temple_outpost": "R54_build_temple_outpost",
        "B54_button_move_morgurax": "B54_button_move_morgurax",
        "mechanim_ward_conduit_button": "mechanim_ward_conduit_button",
        "cangji_monasteries_button": "cangji_monasteries_button",
        "call_flames_button": "call_flames_button",
      },
      "note": "The buttons of the bar's fifth slot share its place over GFX_province_button_dummy_5; each shows by its own potential in custom_gui/provinceview.txt.",
    },
  },
  "groups": {
    "apui": {
      "label": "aPUI window",
      "selector": "apui",
      "none": true,
      "members": {
        "transmutative_path": "provinceview/buildings_window/aPUI_parent_container/aPUI_transmutative_path_window",
        "gor_vazumbrog_vault": "provinceview/buildings_window/aPUI_parent_container/aPUI_gor_vazumbrog_vault_window",
        "zena_medakas_majestic_menagerie": "provinceview/buildings_window/aPUI_parent_container/aPUI_zena_medakas_majestic_menagerie_window",
        "mangrove_bio_infra": "provinceview/buildings_window/aPUI_parent_container/aPUI_mangrove_bio_infra_window",
        "kobold_citadel": "provinceview/buildings_window/aPUI_parent_container/aPUI_kobold_citadel_window",
        "gene_pillar_interaction": "provinceview/buildings_window/aPUI_parent_container/aPUI_gene_pillar_interaction_window",
      },
    },
    "slot1": {
      "label": "Button bar, slot 1",
      "selector": "slot1",
      "none": true,
      "members": {
        "sedentarization_make_outpost": "provinceview/**/province_button_window_*/sedentarization_make_outpost",
        "merfolk_settlement_button": "provinceview/**/province_button_window_*/merfolk_settlement_button",
        "aPUI_gene_pillar_interaction_button": "provinceview/**/province_button_window_*/aPUI_gene_pillar_interaction_button*",
      },
    },
    "slot2": {
      "label": "Button bar, slot 2",
      "selector": "slot2",
      "none": true,
      "members": {
        "dig_deeper_capital": "provinceview/**/province_button_window_*/dig_deeper_capital",
        "ebonsteel_expand_infra_button": "provinceview/**/province_button_window_*/ebonsteel_expand_infra_button",
        "mangrove_bio_infra_button": "provinceview/**/province_button_window_*/mangrove_bio_infra_button*",
        "open_menu_kobold_citadel": "provinceview/**/province_button_window_*/open_menu_kobold_citadel*",
      },
    },
    "slot3": {
      "label": "Button bar, slot 3",
      "selector": "slot3",
      "none": true,
      "members": {
        "transmutative_path_infuse_chi_button": "provinceview/**/province_button_window_*/transmutative_path_infuse_chi_button*",
        "utubodi_unification_own_button": "provinceview/**/province_button_window_*/utubodi_unification_own_button",
        "utubodi_unification_vassal_button": "provinceview/**/province_button_window_*/utubodi_unification_vassal_button",
      },
    },
    "slot4": {
      "label": "Button bar, slot 4",
      "selector": "slot4",
      "none": true,
      "members": {
        "harpy_roost_button": "provinceview/**/province_button_window_*/harpy_roost_button",
        "deepwoods_rangers_button": "provinceview/**/province_button_window_*/deepwoods_rangers_button",
        "lencori_behemoth_shipyard_button": "provinceview/**/province_button_window_*/lencori_behemoth_shipyard_button",
        "charkuchin_kobold_supply_facility_button": "provinceview/**/province_button_window_*/charkuchin_kobold_supply_facility_button",
      },
    },
    "slot5": {
      "label": "Button bar, slot 5",
      "selector": "slot5",
      "none": true,
      "members": {
        "aPUI_zena_medakas_majestic_menagerie_button": "provinceview/**/province_button_window_*/aPUI_zena_medakas_majestic_menagerie_button*",
        "khatalashya_province_button": "provinceview/**/province_button_window_*/khatalashya_province_button",
        "aPUI_gor_vazumbrog_vault_button": "provinceview/**/province_button_window_*/aPUI_gor_vazumbrog_vault_button*",
        "gor_vazumbrog_province_action_road": "provinceview/**/province_button_window_*/gor_vazumbrog_province_action_road",
        "gor_vazumbrog_province_action_cavern": "provinceview/**/province_button_window_*/gor_vazumbrog_province_action_cavern",
        "arawkelin_deforestation_button": "provinceview/**/province_button_window_*/arawkelin_deforestation_button",
        "A49_create_wyvern_farm_button": "provinceview/**/province_button_window_*/A49_create_wyvern_farm_button",
        "chaqway_markets_button": "provinceview/**/province_button_window_*/chaqway_markets_button",
        "verne_port_of_adventure_button": "provinceview/**/province_button_window_*/verne_port_of_adventure_button",
        "S15_aquaculture_button": "provinceview/**/province_button_window_*/S15_aquaculture_button",
        "celmaldor_trade_league_investment": "provinceview/**/province_button_window_*/celmaldor_trade_league_investment",
        "I57_challenge_to_negeal_button": "provinceview/**/province_button_window_*/I57_challenge_to_negeal_button",
        "jungle_fortress_button": "provinceview/**/province_button_window_*/jungle_fortress_button",
        "spiked_log_install_spiky_traps_button": "provinceview/**/province_button_window_*/spiked_log_install_spiky_traps_button",
        "R36_traveling_society_button": "provinceview/**/province_button_window_*/R36_traveling_society_button",
        "S90_spire_explode_button": "provinceview/**/province_button_window_*/S90_spire_explode_button",
        "R54_build_temple_outpost": "provinceview/**/province_button_window_*/R54_build_temple_outpost",
        "B54_button_move_morgurax": "provinceview/**/province_button_window_*/B54_button_move_morgurax",
        "mechanim_ward_conduit_button": "provinceview/**/province_button_window_*/mechanim_ward_conduit_button",
        "cangji_monasteries_button": "provinceview/**/province_button_window_*/cangji_monasteries_button",
        "call_flames_button": "provinceview/**/province_button_window_*/call_flames_button",
      },
    },
  },
  "rules": {
    "button-bar-closed": {
      "when": { "buttonBar": "closed" },
      "hide": ["provinceview/province_window/province_button_window_closed"],
    },
    "button-bar-open": {
      "note": "province_button_button opens the bar and shows while it is closed (custom_gui/provinceview.txt 512).",
      "when": { "buttonBar": "open" },
      "hide": ["provinceview/province_window/province_button_button"],
    },
    "button-bar-foreign": {
      "note": "The bar and its opener are the player's and their subjects' provinces' (custom_gui/provinceview.txt 512-572).",
      "when": { "owner": "no" },
      "hide": [
        "provinceview/province_window/province_button_button",
        "provinceview/province_window/province_button_window_closed",
      ],
    },
    "digging-closed": {
      "hide": ["provinceview/province_window/diggy_*"],
    },
    "dig": {
      "when": { "digging": ["dig", "digging"], "owner": "yes" },
      "show": [
        "provinceview/province_window/diggy_diggy_estimate",
        "provinceview/province_window/diggy_diggy_go",
        "provinceview/province_window/diggy_cost_text*",
        "provinceview/province_window/diggy_time_text*",
      ],
    },
    "repair": {
      "when": { "digging": "repair", "owner": "yes" },
      "show": [
        "provinceview/province_window/diggy_diggy_estimate",
        "provinceview/province_window/diggy_diggy_repair",
        "provinceview/province_window/diggy_cost_text*",
        "provinceview/province_window/diggy_time_text*",
      ],
    },
    "digging-progress": {
      "when": { "digging": "digging", "owner": "yes" },
      "show": [
        "provinceview/province_window/diggy_diggy_bar_label",
        "provinceview/province_window/diggy_diggy_bar_fill_1",
        "provinceview/province_window/diggy_diggy_bar_fill_2",
        "provinceview/province_window/diggy_diggy_bar_fill_3",
      ],
    },
    "nomad-capital": {
      "hide": [
        "provinceview/province_window/IW_move_capital_button",
        "provinceview/province_window/IW_move_capital_blocker",
      ],
    },
    "centaur-capital": {
      "when": { "centaurCapital": "yes", "owner": "yes" },
      "show": [
        "provinceview/province_window/IW_move_capital_button",
        "provinceview/province_window/IW_move_capital_blocker",
      ],
    },
    "parliament-seats": {
      "hide": ["provinceview/province_window/add_parliament_forbidden"],
    },
    "parliament-seats-forbidden": {
      "when": { "parliamentForbidden": "forbidden", "parliament": "noSeat", "owner": "yes" },
      "show": ["provinceview/province_window/add_parliament_forbidden"],
    },
    "button-bars-foreign": {
      "note": "Anbennar's own layout: the bars in the buildings panel are the player's and their subjects' provinces' (custom_gui/provinceview.txt 550, 561); P2KE Patch - Anbennar drops them.",
      "when": { "owner": "no" },
      "hide": ["provinceview/buildings_window/**/province_button_window_*_monument"],
    },
    "apui-debug": {
      "note": "Anbennar's own layout: shown only in Anbennar's debug mode.",
      "hide": [
        "provinceview/buildings_window/province_button_window_no_monument/aPUI_debug_button",
      ],
    },
    "apui-template": {
      "note": "Shown only in Anbennar's debug mode.",
      "hide": ["provinceview/buildings_window/aPUI_parent_container/aPUI_template_window"],
    },
  },
  "views": {
    "button-bar": {
      "label": "Province button bar",
      "set": {
        "owner": "yes",
        "tab": "province",
        "side": "buildings",
        "subPanel": "none",
        "buttonBar": "open",
        "apui": "none",
      },
    },
    "kobold-citadel": {
      "label": "Kobold citadel",
      "set": {
        "owner": "yes",
        "tab": "province",
        "side": "buildings",
        "subPanel": "none",
        "buttonBar": "open",
        "apui": "kobold_citadel",
      },
    },
    "gene-pillars": {
      "label": "Gene pillars",
      "set": {
        "owner": "yes",
        "tab": "province",
        "side": "buildings",
        "subPanel": "none",
        "buttonBar": "open",
        "apui": "gene_pillar_interaction",
      },
    },
  },
}
